    }
    if (PHASE_LABELS[q.phase]) form.prepend(el("p", { className: "tutor-label", textContent: PHASE_LABELS[q.phase] }));
    if (q.probe) form.prepend(el("p", { className: "tutor-label", textContent: `Question ${q.probe.n} of ${q.probe.of}` }));
    form.append(...body, thoughtLink, thoughtBox, buttons, status);

    const submit = async (reply, summaryText) => {
      form.querySelectorAll("button, input, textarea").forEach((c) => { c.disabled = true; });
      status.textContent = "";
      try {
        const res = await fetch("/tutor/answer", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ id: q.id, secret: q.secret, thought: thought.value.trim() || undefined, ...reply }),
        });
        if (res.ok) { cards.delete(q.id); collapse(form, summaryText); return; }
        if (res.status === 410) return expire(q.id); // the Tutor stopped waiting before this answer came
        status.textContent = (await res.json().catch(() => ({}))).error ?? "Could not send the answer";
      } catch (err) {
        status.textContent = `Could not reach the core: ${err.message}`;
      }
      form.querySelectorAll("button, input, textarea").forEach((c) => { c.disabled = false; }); // the person can try again
    };
    form.onsubmit = (e) => {
      e.preventDefault();
      if (q.kind === "choice") {
        submit({ option: Number(form.elements[`tutor-option-${n}`].value), confidence: Number(form.elements[`tutor-confidence-${n}`].value) }, summary());
      } else submit({ text: form.querySelector("textarea").value }, summary());
    };
    if (dontKnow) dontKnow.onclick = () => {
      // The required fields must not stop someone who does not know.
      submit({ dontKnow: true }, "You said: I don't know");
    };

    log.append(form);
    cards.set(q.id, { form, first, opts: running?.opts }); // the kind of class that asked (layer, decision, guide, drift, Probe...), to begin the same one again
    form.scrollIntoView?.({ block: "nearest" });
    first.focus();
  }

  function expire(id) {
    const card = cards.get(id);
    if (!card) return;
    cards.delete(id);
    card.form.querySelectorAll("button, input, textarea").forEach((c) => { c.disabled = true; });
    card.form.querySelector(".tutor-status").textContent = "Expired: the Tutor stopped waiting for an answer";
    // What the person already answered is kept; one click begins again on the same topic.
    const again = el("button", { type: "button", textContent: "Start a class on the same topic" });
    again.onclick = () => {
      again.disabled = true;
      running?.abort.abort();
      const go = () => (running ? setTimeout(go, 50) : startClass(card.opts));
      go();
    };
    card.form.append(el("p", { className: "tutor-meta", textContent: "Your earlier answers are kept." }), again);
  }

  const UNREACHABLE = ["not_installed", "not_signed_in", "failed"];
  function render(event) {
    // A class that asked for a fallback (the layer class's quick tour) does not show an error when the Tutor could not be reached at all.
    if (event.type === "error" && running?.fallback && !running.heard && UNREACHABLE.includes(event.code)) { running.unavailable = true; return; }
    if (event.type !== "session" && event.type !== "error" && running) running.heard = true;
    if (event.type === "text") line("tutor-say", event.text);
    else if (event.type === "tutor_step") { log.append(el("h3", { className: "tutor-step", textContent: event.title })); pane.scrollTop = pane.scrollHeight; }
    else if (event.type === "tutor_explain") { if (event.repair) line("tutor-label", "Let's look again"); line("tutor-say", event.text); }
    else if (event.type === "tutor_finished") line("tutor-meta", `Class finished: ${event.summary}`);
    else if (event.type === "proposal") tutorProposal(event);
    else if (event.type === "proposal_refused") tutorRefused(event);
    else if (event.type === "tutor_question") questionCard(event);
    else if (event.type === "tutor_question_expired") expire(event.id);
    else if (event.type === "error") { const p = el("p", { className: "tutor-error", textContent: event.message }); p.setAttribute("role", "alert"); log.append(p); }
    else if (event.type === "learner") { learnerLine(event); document.dispatchEvent(new CustomEvent("plan-changed")); }
    else if (event.type === "tutor_plan") document.dispatchEvent(new CustomEvent("plan-changed"));
    else if (event.type === "probe_done") line("tutor-meta", `Known: ${event.counts.known}, partly: ${event.counts.partial}, new to you: ${event.counts.unknown}`);
    else if (event.type === "probe_skipped") line("tutor-meta", "Probe skipped. You can start a class anyway.");
  }

  // A Proposal the Tutor made from the person's answer: the Canvas shows it pending on its layer; here a line says so and offers the way there.
  function tutorProposal(event) {
    const review = el("button", { type: "button", textContent: "Review" });
    review.onclick = () => document.dispatchEvent(new CustomEvent("proposal-open", { detail: { id: event.id } }));
    log.append(el("p", { className: "tutor-meta tutor-proposal" }, el("strong", { textContent: "From the Tutor: " }), `proposal to ${event.kind === "add" ? "add" : "change"} "${event.nodeId}" on the ${event.layer} layer. `, review));
    document.dispatchEvent(new CustomEvent("proposal-created", { detail: event }));
    pane.scrollTop = pane.scrollHeight;
  }

  // A Proposal the Tutor tried to make and the core refused: one plain line with why, and the way to the one that is waiting.
  function tutorRefused(event) {
    log.append(el("p", { className: "tutor-meta tutor-proposal" }, ...proposalRefusedParts(event, "The Tutor")));
    pane.scrollTop = pane.scrollHeight;
  }

  // After a class: one plain line about the Learner graph. If the pipeline failed, a Retry button asks the core again.
  function learnerLine(event) {
    if (event.status === "saved") return void (event.ideas > 0 && line("tutor-meta", `Saved ${event.ideas} ${event.ideas === 1 ? "idea" : "ideas"} to your map`));
    const p = el("p", { className: "tutor-error", textContent: `${event.message} ` });
    const retry = el("button", { type: "button", textContent: "Retry" });
    retry.onclick = async () => {
      retry.disabled = true;
      const res = await fetch(`/tutor/classes/${encodeURIComponent(event.classId)}/close`, { method: "POST" }).catch(() => null);
      const body = await res?.json().catch(() => ({}));
      if (res?.ok) { p.className = "tutor-meta"; p.textContent = `Saved ${body.ideas} ${body.ideas === 1 ? "idea" : "ideas"} to your map`; }
      else { p.firstChild.textContent = `${body?.message ?? body?.error ?? "Could not reach the core"} `; retry.disabled = false; }
    };
    p.append(retry);
    log.append(p);
  }

  // Back from a class: the conversation stays on screen, with the way to begin another one below it.
  function finish(opts = {}) {
    for (const id of [...cards.keys()]) expire(id);
    running = null;
    line("tutor-meta", opts.ended ?? "The class has ended.");
    pane.classList.replace("tutor-live", "tutor-over");
    end.hidden = true;
    start.disabled = !current;
    start.textContent = opts.ended ? "Start a class" : "Start another class";
  }

  // `opts` lets another feature (the Probe, 51-probe.js) use the same column: its endpoint and body, the label of the stop button, what stop does, and the closing line.
  async function startClass(opts = {}) {
    if (!current || running) return;
    const project = current;
    running = { abort: new AbortController(), project, skip: opts.skip, fallback: opts.fallback, opts };
    end.textContent = opts.endLabel ?? "End class";
    log.replaceChildren();
    log.hidden = false;
    pane.classList.remove("tutor-over");
    pane.classList.add("tutor-live");
    pane.querySelectorAll("details.tutor-section[open]").forEach((d) => { d.open = false; }); // the sections stay folded during a class
    end.hidden = false;
    start.disabled = true;
    end.focus();
    let unavailable = false;
    try {
      const res = await fetch(opts.path ?? "/tutor/classes", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(opts.payload ?? { project, topic: topic.value.trim() || undefined }), signal: running.abort.signal });
      if (!res.ok) {
        const p = el("p", { className: "tutor-error", textContent: (await res.json().catch(() => ({}))).error ?? "The class could not start" });
        p.setAttribute("role", "alert");
        log.append(p);
      } else {
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = "";
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split("\n");
          buffer = lines.pop();
          for (const l of lines) if (l) render(JSON.parse(l));
        }
      }
    } catch (err) {
      if (err.name !== "AbortError") { const p = el("p", { className: "tutor-error", textContent: `Could not reach the core: ${err.message}` }); p.setAttribute("role", "alert"); log.append(p); }
    } finally {
      unavailable = running?.unavailable === true;
      finish(unavailable ? { ended: "The Tutor is not available." } : opts);
      opts.after?.();
    }
    return unavailable; // true: the Tutor could not be reached and the caller asked for a fallback
  }

  start.onclick = () => startClass();
  end.onclick = () => (running?.skip ? running.skip() : running?.abort.abort()); // closing the stream ends the class in the core
  window.tutorUi = { startClass, abort: () => running?.abort.abort(), isRunning: () => running !== null };
  document.addEventListener("project-opened", (e) => {
    if (running && running.project !== e.detail.id) running.abort.abort();
    if (!running) { log.replaceChildren(); log.hidden = true; pane.classList.remove("tutor-live", "tutor-over"); start.textContent = "Start a class"; }
    setAvailable(true);
  });
}

</script>
<script>
// The Probe offer in the Tutor panel (ticket 06): before a layer's first class the person may check what they know (five questions
// at most) or skip it. It never blocks: "Start a class" is always there. The questions are drawn by 50-tutor.js; the core decides
// everything (what is asked, what is stored). Names are prefixed "probe" because every feature file shares one global scope.
{
  const style = document.createElement("style");
  style.textContent = `
    #probe-offer { margin: 0; font-size: 12px; color: var(--muted); }
    #pane-tutor.tutor-live #probe-offer { display: none; }
  `;
  document.head.append(style);

  // One quiet line, not a button: the person may check what they know, and "Start a class" stays the main action.
  const offer = Object.assign(document.createElement("p"), { id: "probe-offer", hidden: true });
  $("tutor-head").after(offer);

  const post = (path, body) => fetch(path, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
  const layerKey = () => authoredShown; // the layer on screen: "components" is the derived view
  const layerName = (k) => k.charAt(0).toUpperCase() + k.slice(1);
  let token = 0; // a late answer for a layer or Project that is no longer on screen is ignored

  const link = (text, onclick) => Object.assign(document.createElement("button"), { type: "button", textContent: text, onclick });
  const dot = () => document.createTextNode(" · ");

  async function refresh() {
    const mine = ++token;
    const project = current, layer = layerKey();
    if (!project) { offer.hidden = true; return; }
    let result = null;
    try {
      const res = await fetch(`/tutor/probes?project=${encodeURIComponent(project)}&layer=${layer}`);
      if (res.ok) result = (await res.json()).result;
    } catch { /* the offer is only a convenience: without the core it simply shows the unchecked state */ }
    if (mine !== token) return;
    offer.title = "";
    if (result?.status === "done") {
      const c = { known: 0, partial: 0, unknown: 0 };
      for (const t of result.topics) c[t.status]++;
      offer.title = `Known: ${c.known}, partly: ${c.partial}, new to you: ${c.unknown}`;
      offer.replaceChildren(`${layerName(layer)}: checked`, dot(), link("Redo", () => begin(layer)));
    } else if (result?.status === "skipped") {
      offer.replaceChildren(`${layerName(layer)}: check skipped`, dot(), link("Check what I know (3 to 5 questions)", () => begin(layer)));
    } else {
      offer.replaceChildren(
        `${layerName(layer)}: not checked yet`, dot(), link("Check what I know (3 to 5 questions)", () => begin(layer)),
        dot(), link("Skip", async () => { await post("/tutor/probes/skip", { project, layer }).catch(() => null); refresh(); }),
      );
    }
    offer.hidden = false;
  }

  function begin(layer) {
    const project = current;
    if (!project || !window.tutorUi) return;
    return window.tutorUi.startClass({
      path: "/tutor/probes",
      payload: { project, layer, redo: true },
      endLabel: "Skip probe",
      ended: "The check is over. You can start a class.",
      // Stopping the Probe is a skip: the core stores it and ends the stream; if it cannot be reached, closing the stream does the same job.
      skip: async () => {
        const res = await post("/tutor/probes/skip", { project, layer }).catch(() => null);
        if (!res?.ok) window.tutorUi.abort();
      },
      after: refresh,
    });
  }

  window.probeUi = { begin }; // the layer class (46-layer-class.js) runs the Probe first when the layer was never checked
  document.addEventListener("project-opened", refresh);
  const showLayerWithoutProbe = showLayer; // however a layer is shown (tab, View code, a step), each layer has its own Probe
  showLayer = (which) => { showLayerWithoutProbe(which); refresh(); };
}

</script>
<script>
// The Plan section in the Tutor pane (ticket 07): the concepts to understand, in dependency order, and the open decisions of each layer.
// The core stores the Plan and derives what is covered (GET /tutor/plan); this only draws them. There is no editing here:
// the person asks the Tutor for changes in the conversation. Names are prefixed "plan" because every feature file shares one global scope.
{
  const style = document.createElement("style");
  style.textContent = `
    #plan-card .plan-bar { height: 4px; border-radius: 2px; background: var(--control); overflow: hidden; }
    #plan-card .plan-bar i { display: block; height: 100%; background: var(--derived); }
    #plan-card ol, #plan-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    #plan-card li { display: grid; grid-template-columns: 30px 1fr; gap: 0 6px; align-items: baseline; font-size: 13px; color: var(--label); }
    #plan-card li.covered { color: var(--text); }
    #plan-card .plan-n { color: var(--muted); font-size: 12px; text-align: right; }
    #plan-card .mark { color: var(--derived); font-weight: 700; }
    #plan-card .needs { grid-column: 2; font-size: 12px; color: var(--muted); }
    #plan-card h3 { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  `;
  document.head.append(style);

  const section = tutorSection("plan", "Plan");
  const card = section.el;
  $("contract-card").before(card); // above the Contract: it is what the person reads first

  // Concepts so that each comes after the ones it needs (the core guarantees there is no cycle).
  const planNorm = (s) => s.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim(); // the core's `normalise`
  function planOrder(concepts) {
    const byName = new Map(concepts.map((c) => [planNorm(c.name), c]));
    const out = [], seen = new Set();
    const visit = (c) => {
      if (seen.has(c)) return;
      seen.add(c);
      c.dependsOn.forEach((d) => byName.has(planNorm(d)) && visit(byName.get(planNorm(d))));
      out.push(c);
    };
    concepts.forEach(visit);
    return out;
  }

  const planAfter = (numbers) => `after ${numbers.length > 1 ? `${numbers.slice(0, -1).join(", ")} and ${numbers.at(-1)}` : numbers[0]}`;
  const mk = (tag, props = {}, ...kids) => { const e = Object.assign(document.createElement(tag), props); e.append(...kids); return e; };
  let planToken = 0;

  async function planRefresh() {
    const mine = ++planToken, project = current;
    const body = project ? await fetch(`/tutor/plan?project=${encodeURIComponent(project)}`).then((r) => (r.ok ? r.json() : null)).catch(() => null) : null;
    if (mine !== planToken) return; // a newer refresh, or another Project, took over
    card.hidden = !body?.plan;
    if (!body?.plan) return;
    const covered = new Set(body.covered.map(planNorm));
    const ordered = planOrder(body.plan.concepts);
    const number = new Map(ordered.map((c, i) => [planNorm(c.name), i + 1])); // the numbers of the list, for "after 1 and 2"
    const done = ordered.filter((c) => covered.has(planNorm(c.name))).length;
    section.summarise(`${done} of ${ordered.length} covered`);
    const concepts = ordered.map((c, i) => {
      const isDone = covered.has(planNorm(c.name));
      const n = mk("span", { className: "plan-n", textContent: String(i + 1) });
      if (isDone) {
        const mark = mk("span", { className: "mark", textContent: " ✓" });
        mark.setAttribute("role", "img");
        mark.setAttribute("aria-label", "covered");
        n.append(mark);
      }
      const li = mk("li", { className: isDone ? "covered" : "" }, n, mk("span", { textContent: c.name }));
      const needs = c.dependsOn.map((d) => number.get(planNorm(d))).filter(Boolean).sort((a, b) => a - b);
      if (needs.length) li.append(mk("span", { className: "needs", textContent: planAfter(needs) }));
      return li;
    });
    const bar = mk("div", { className: "plan-bar" }, mk("i"));
    bar.firstChild.style.width = `${ordered.length ? (done / ordered.length) * 100 : 0}%`;
    section.body.replaceChildren(bar, mk("ol", {}, ...concepts), mk("p", { textContent: "Ask the Tutor if you want the Plan changed." }));
    if (body.plan.decisions.length) {
      section.body.append(mk("h3", { textContent: "Open decisions" }), mk("ul", {}, ...body.plan.decisions.map((d) => mk("li", {}, mk("span", { className: "plan-n", textContent: "?" }), mk("span", { textContent: `${d.layer}: ${d.question}` })))));
    }
  }

  document.addEventListener("project-opened", planRefresh);
  document.addEventListener("plan-changed", planRefresh); // the Tutor set or revised the Plan, or a class ended (what is covered may have changed)
}

</script>
<script>
// Drift in the Tutor pane (ticket 12): where the built code differs from the Contract, as a plain list, with a dashed mark on the affected Nodes
// of their layers and a button that turns a difference into a class. The core derives everything (GET /drift); this only draws it.
// A difference is information: nothing here blocks the person or the builder. Names are prefixed "drift" because every feature file shares one global scope.
{
  const style = document.createElement("style");
  style.textContent = `
    #drift-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
    #drift-card li { font-size: 13px; color: var(--label); overflow-wrap: anywhere; }
    #drift-card .kind { display: block; margin-bottom: 2px; font: 11px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
    #drift-card .row { display: flex; gap: 8px; margin-top: 6px; }
    #drift-card .row button { padding: 3px 10px; font-size: 12px; background: transparent; color: var(--text); border: 1px solid var(--control); }
    .anode.has-drift rect, .bnote.has-drift rect { stroke: var(--danger); stroke-width: 1.5; stroke-dasharray: 5 3; }
    .anode.has-waiting rect, .bnote.has-waiting rect { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 3; }
  `;
  document.head.append(style);

  const section = tutorSection("drift", "Differences");
  const card = section.el;
  $("contract-card").before(card);

  const KINDS = {
    "broken-trace": "Link broken",
    "built-without-code": "Marked built, no code",
    "missing-relationship": "Declared, not in the code",
    "undeclared-dependency": "In the code, not declared",
    pattern: "Pattern rule",
    "not-built-yet": "Not built yet",
  };
  const mk = (tag, props = {}, ...kids) => { const e = Object.assign(document.createElement(tag), props); e.append(...kids); return e; };
  let driftList = [], driftToken = 0;

  // The Nodes named by a difference carry a dashed outline on the layer it is about. Every redraw calls this again.
  function driftMark() {
    document.querySelectorAll(".anode.has-drift, .bnote.has-drift, .anode.has-waiting, .bnote.has-waiting").forEach((n) => n.classList.remove("has-drift", "has-waiting"));
    for (const d of driftList) {
      for (const id of d.nodes) {
        authoredGroup.querySelector(`g[data-layer="${d.layer}"] [data-node="${id}"]`)?.classList.add(d.type === "not-built-yet" ? "has-waiting" : "has-drift");
      }
    }
  }

  function driftDraw() {
    card.hidden = !current;
    if (!current) return;
    const items = driftList.map((d) => {
      const show = mk("button", { type: "button", textContent: `Show on ${d.layer}` });
      show.onclick = () => showLayer(d.layer);
      const ask = mk("button", { type: "button", textContent: "Ask me about it" });
      ask.onclick = () => window.tutorUi?.startClass({ payload: { project: current, drift: d.id } });
      return mk("li", {}, mk("span", { className: "kind", textContent: `${KINDS[d.type] ?? d.type}${d.certainty === "possible" ? " (possible)" : ""}` }), d.explanation, mk("div", { className: "row" }, show, ask));
    });
    section.summarise(driftList.length ? String(driftList.length) : "none");
    section.body.replaceChildren(
      mk("p", { textContent: driftList.length ? "Where your code is not what you agreed. It is only information: nothing is blocked, and either side may be the one to change." : "No differences found between your code and what you agreed." }),
      ...(items.length ? [mk("ul", {}, ...items)] : []),
    );
  }

  async function driftRefresh() {
    const mine = ++driftToken, project = current;
    const body = project ? await fetch(`/drift?project=${encodeURIComponent(project)}`).then((r) => (r.ok ? r.json() : null)).catch(() => null) : null;
    if (mine !== driftToken) return;
    driftList = body?.drift ?? [];
    driftDraw();
    driftMark();
  }

  const swatch = notationSwatch(`<rect x="4" y="4" width="36" height="16" rx="4" style="fill:none;stroke:var(--danger);stroke-width:1.5;stroke-dasharray:5 3"/>`);
  const waiting = notationSwatch(`<rect x="4" y="4" width="36" height="16" rx="4" style="fill:none;stroke:var(--muted);stroke-width:1;stroke-dasharray:2 3"/>`);
  for (const layer of ["business", "requirements", "architecture"]) {
    const legend = notationLegends[layer];
    notationRegisterLegend(layer, { ...legend, shapes: [...legend.shapes, [swatch, "Dashed red outline: the code differs from what the Contract says about this Node (see the list in the Tutor panel)", ".has-drift"], ...(layer === "requirements" ? [[waiting, "Dotted grey outline: a requirement not built yet, only a question to ask (see the Tutor panel)", ".has-waiting"]] : [])] });
  }

  const drawWithoutDrift = draw;
  draw = async (nodes) => { await drawWithoutDrift(nodes); await driftRefresh(); };
  const showLayerWithoutDrift = showLayer;
  showLayer = (which) => { showLayerWithoutDrift(which); driftMark(); };
  document.addEventListener("proposals-changed", driftRefresh); // an accepted Proposal changes the Contract
}

</script>
<script>
// Select any text to learn about it (ticket 13): selecting text anywhere (a builder reply, a Rationale, the Code panel, the Tutor's own words)
// shows a small control next to it with "Explain" (a brief explanation, no class) and "Enter the Tutor" (a free class on that text).
// Text typed in the person's own input boxes never triggers it. The core does the work (POST /tutor/define, POST /tutor/classes {selection});
// the selected text only travels as data. Names are prefixed "select" because every feature file shares one global scope.
{
  const MAX = 2000; // the core's limit on a selection
  const MAX_TERMINAL = 8000; // the core's limit on text selected in the terminal (the Terminal marks its log with data-selection-source="terminal")
  const style = document.createElement("style");
  style.textContent = `
    #select-pop { position: fixed; z-index: 30; max-width: 320px; padding: 6px; background: var(--panel); border: 1px solid var(--accent); border-radius: 10px; box-shadow: 0 10px 28px #0009; font-size: 13px; color: var(--text); }
    #select-pop[hidden] { display: none; }
    #select-pop .row { display: flex; gap: 6px; }
    #select-pop button { padding: 3px 10px; font-size: 12.5px; background: transparent; color: var(--text); border: 1px solid var(--control); }
    #select-pop button.primary { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
    #select-pop button:disabled { opacity: .5; }
    #select-pop .said { margin: 6px 2px 2px; line-height: 1.45; white-space: pre-wrap; overflow-wrap: anywhere; }
    #select-pop .said.error { color: var(--danger); }
    #select-pop .hint { margin: 6px 2px 2px; font-size: 12px; color: var(--muted); }
    #select-pop .warn { margin: 2px; }
    #select-pop .warn[hidden] { display: none; }
    #select-pop .warn p { margin: 0 0 6px; font-size: 12px; line-height: 1.45; color: var(--text); }
  `;
  document.head.append(style);

  const pop = Object.assign(document.createElement("div"), { id: "select-pop", hidden: true, role: "dialog" });
  pop.setAttribute("aria-label", "Learn about the selected text");
  const define = Object.assign(document.createElement("button"), { type: "button", textContent: "Explain" });
  const enter = Object.assign(document.createElement("button"), { type: "button", textContent: "Enter the Tutor", className: "primary" });
  // Only where fixing makes sense (the terminal and the Code panel mark themselves with data-selection-fix): the two buttons that hand the text to the Builder.
  const fix = Object.assign(document.createElement("button"), { type: "button", textContent: "Fix", hidden: true });
  const explainFix = Object.assign(document.createElement("button"), { type: "button", textContent: "Explain and fix", hidden: true });
  const row = Object.assign(document.createElement("div"), { className: "row" });
  const said = Object.assign(document.createElement("p"), { className: "said", hidden: true });
  said.setAttribute("role", "status");
  const hint = Object.assign(document.createElement("p"), { className: "hint", hidden: true });
  // "This looks like a secret": asked before any button sends text. The text is never changed or hidden; the check is a warning, not a guarantee.
  const warn = Object.assign(document.createElement("div"), { className: "warn", hidden: true });
  const warnText = Object.assign(document.createElement("p"), { textContent: "This looks like a secret (a key, a password or a token). Send it anyway? This check is a warning, not a guarantee: read the text yourself before you send it." });
  const warnRow = Object.assign(document.createElement("div"), { className: "row" });
  const sendAnyway = Object.assign(document.createElement("button"), { type: "button", textContent: "Send anyway" });
  const cancel = Object.assign(document.createElement("button"), { type: "button", textContent: "Cancel" });
  warnRow.append(sendAnyway, cancel);
  warn.append(warnText, warnRow);
  row.append(define, fix, explainFix, enter);
  pop.append(row, warn, said, hint);
  document.body.append(pop);

  let text = "", source, token = 0; // text is what would be sent; source is "terminal" for text selected there
  let afterWarning = null; // what to do when the person confirms the secret warning
  const resetWarning = () => { afterWarning = null; warn.hidden = true; row.hidden = false; };
  const hide = () => { pop.hidden = true; said.hidden = true; said.textContent = ""; text = ""; token++; resetWarning(); };

  // Does this text look like a secret? Made-up examples of each: a private key header, "DB_PASSWORD=hunter2hunter2", "password: correct-horse-9", "Bearer <long token>",
  // a key with a known prefix (sk-, ghp_, AKIA...), "postgres://user:pass@host", or one long mixed-case string of letters and digits. Ids, hashes and paths are not flagged.
  function selectLooksLikeSecret(value) {
    const t = value.replace(/\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/gi, ""); // a UUID is an id, not a key
    const name = "\\b\\w*(?:password|passwd|pwd|secret|token|api[_-]?key|access[_-]?key)\\w*[\"']?";
    return [
      /-----BEGIN [A-Z ]*PRIVATE KEY-----/,
      new RegExp(name + "\\s*=\\s*[\"']?[^\\s\"']{6,}", "i"), // NAME=value
      new RegExp(name + "\\s*:\\s*[\"']?(?=[^\\s\"']*\\d)[^\\s\"']{8,}", "i"), // name: value, only when the value has a digit ("Invalid token: expected string" is not a secret)
      /\bBearer\s+[A-Za-z0-9._~+\/-]{16,}/,
      /\b(?:sk-|sk_live_|pk_live_|rk_live_|ghp_|gho_|ghs_|github_pat_|xox[baprs]-|AKIA|ASIA|AIza)[A-Za-z0-9_-]{12,}/,
      /[a-z][a-z0-9+.-]*:\/\/[^\s:@\/]+:[^\s@\/]+@/i,
      /\b(?=[A-Za-z0-9_-]*\d)(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*[A-Z])[A-Za-z0-9_-]{32,}\b/,
    ].some((re) => re.test(t));
  }
  // Runs `go` now, or after the person confirms when the text looks like a secret.
  function sendOrWarn(go) {
    if (!selectLooksLikeSecret(text)) return go();
    afterWarning = go;
    row.hidden = true;
    warn.hidden = false;
  }
  sendAnyway.onclick = () => { const go = afterWarning; resetWarning(); go?.(); };
  cancel.onclick = resetWarning;

  // Is the selection in a box the person types in? Those never offer the control.
  const typing = (node) => {
    const el = node?.nodeType === 1 ? node : node?.parentElement;
    return !!el?.closest?.("input, textarea, select, [contenteditable]:not([contenteditable='false'])");
  };

  const inFixable = (node) => !!(node?.nodeType === 1 ? node : node?.parentElement)?.closest?.("[data-selection-fix]");
  const inTerminal = (node) => !!(node?.nodeType === 1 ? node : node?.parentElement)?.closest?.('[data-selection-source="terminal"]');

  function check() {
    const sel = window.getSelection();
    const picked = sel?.toString().trim() ?? "";
    if (!picked || !sel.rangeCount || !current || typing(sel.anchorNode) || typing(sel.focusNode) || typing(document.activeElement)) return;
    if (pop.contains(sel.anchorNode)) return;
    // A long traceback keeps its END, where the error is: the control says it cut the start.
    const fromTerminal = inTerminal(sel.anchorNode) && inTerminal(sel.focusNode);
    const cut = fromTerminal && picked.length > MAX_TERMINAL;
    const sent = cut ? picked.slice(-MAX_TERMINAL) : picked;
    if (sent !== text) { token++; said.hidden = true; resetWarning(); } // a definition still on its way belongs to the old selection
    text = sent;
    source = fromTerminal ? "terminal" : undefined;
    const tooLong = !fromTerminal && picked.length > MAX;
    const busy = window.tutorUi?.isRunning();
    const fixable = inFixable(sel.anchorNode) && inFixable(sel.focusNode);
    const builderBusy = fixable && window.chatUi?.isBusy();
    fix.hidden = explainFix.hidden = !fixable;
    define.disabled = tooLong;
    enter.disabled = tooLong || busy;
    fix.disabled = explainFix.disabled = tooLong || builderBusy;
    hint.textContent = tooLong ? `Select less text: up to ${MAX} characters.` : cut ? `Only the last ${MAX_TERMINAL} characters are sent: the start was cut.` : busy ? "A class is running: end it to start another." : "The Builder is answering: wait for it to finish.";
    hint.hidden = !(tooLong || cut || busy || builderBusy);
    pop.hidden = false;
    // Next to where the selection ends (the last line of it), not to the box around all of it: a long selection reaches far above the screen.
    const range = sel.getRangeAt(0), lines = range.getClientRects();
    const r = lines.length ? lines[lines.length - 1] : range.getBoundingClientRect();
    const w = pop.offsetWidth, h = pop.offsetHeight;
    pop.style.left = `${Math.max(8, Math.min(r.left, innerWidth - w - 8))}px`;
    pop.style.top = `${r.bottom + 8 + h > innerHeight ? Math.max(8, r.top - h - 8) : r.bottom + 8}px`;
  }

  // The selection settles on mouse up or after keyboard selection; a click elsewhere or Escape closes the control.
  document.addEventListener("mouseup", (e) => { if (!pop.contains(e.target)) setTimeout(check, 0); });
  document.addEventListener("keyup", (e) => { if (e.shiftKey && e.key.startsWith("Arrow")) check(); });
  document.addEventListener("mousedown", (e) => { if (!pop.hidden && !pop.contains(e.target)) hide(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !pop.hidden) { hide(); e.stopPropagation(); } }, true);
  pop.addEventListener("mousedown", (e) => e.preventDefault()); // keeps the selection while a button is pressed

  define.onclick = () => sendOrWarn(explain);
  fix.onclick = () => sendOrWarn(() => { const asked = text, from = source; hide(); window.getSelection()?.removeAllRanges(); window.chatUi?.fix(asked, from); });
  explainFix.onclick = () => sendOrWarn(() => { explain(); window.chatUi?.fix(text, source); }); // the explanation shows here while the Builder works in the chat
  enter.onclick = () => sendOrWarn(enterTheTutor);
  async function explain() {
    const mine = ++token, project = current, asked = text, from = source;
    define.disabled = true; // the answer re-enables it only if the selection has not changed meanwhile
    said.className = "said";
    said.textContent = "Defining…";
    said.hidden = false;
    try {
      const res = await fetch("/tutor/define", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ project, text: asked, source: from }) });
      const body = await res.json().catch(() => ({}));
      if (mine !== token) return;
      said.className = res.ok ? "said" : "said error";
      said.textContent = res.ok ? body.definition : body.error ?? "Could not define this text";
    } catch (err) {
      if (mine !== token) return;
      said.className = "said error";
      said.textContent = `Could not reach the core: ${err.message}`;
    }
    define.disabled = !source && text.length > MAX;
  }
  function enterTheTutor() {
    const asked = text, project = current, from = source;
    hide();
    window.getSelection()?.removeAllRanges();
    window.tutorUi?.startClass({ payload: { project, selection: asked, source: from } });
  };
  document.addEventListener("project-opened", hide);
}

</script>
<script>
// Code panel: the exact source text behind what the person is looking at, in a card of its own beside the Canvas (not a layer, not a floating box).
// It holds the files the person opened as tabs. A tab shows the whole file with line numbers and syntax colours, the lines of a Node or a Flow step highlighted
// and scrolled into view, and remembers those lines and its scroll position while another tab is shown.
// A file is chosen in the Files panel; a Node's code is opened from the Details ("View code") or from a step of a Flow.
// All text comes from the core (GET /source); nothing here derives anything from the code. Names start with "code" because every feature
// file shares one global scope.
// Keys on the tabs (ARIA tablist): Left and Right move between tabs (and show them), Home and End go to the first and the last, Delete closes the tab.
{
  const style = document.createElement("style");
  style.textContent = `
    #pane-code { flex: 1 1 auto; min-height: 0; padding: 0; gap: 0; overflow: hidden; display: flex; flex-direction: column; }
    #code-tabs { display: flex; flex: none; overflow-x: auto; border-bottom: 1px solid var(--line); }
    #code-tabs[hidden] { display: none; }
    #code-tabs .code-tab { display: flex; flex: none; align-items: center; max-width: 220px; border-right: 1px solid var(--line); }
    #code-tabs .code-tab.on { background: var(--selected); box-shadow: inset 0 -2px var(--accent); }
    #code-tabs button { font: 13px var(--sans); background: transparent; border: 0; border-radius: 0; color: var(--muted); padding: 7px 8px; min-height: 30px; }
    #code-tabs button[role="tab"] { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-left: 12px; }
    #code-tabs .code-tab.on button[role="tab"] { color: var(--text); }
    #code-tabs .code-tab.gone button[role="tab"] { font-style: italic; }
    #code-tabs button:hover { background: var(--raised); filter: none; }
    #code-tabs button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    #code-tabs .code-close { flex: none; padding: 7px 8px 7px 2px; }
    #code-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 10px 12px; border-bottom: 1px solid var(--line); flex: none; }
    #code-head .where { flex: 1 1 200px; min-width: 0; overflow-wrap: anywhere; }
    #code-head strong { font-size: 14px; font-weight: 500; color: var(--text); }
    #code-head .lines { margin-left: 8px; font-size: 12px; color: var(--muted); }
    #code-head button { font-size: 13px; }
    #code-head input { flex: 1 1 100%; min-width: 0; font-size: 13px; }
    #code-head .note { flex-basis: 100%; font-size: 12px; color: var(--muted); }
    #code-head [hidden] { display: none; }
    #code-stack { position: relative; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    #code-stack .code-text { position: relative; flex: 1 1 auto; min-height: 0; overflow: auto; padding: 8px 0; font: 12.5px/1.6 var(--mono); font-variant-ligatures: none; /* the text is shown exactly as written */ color: var(--text); }
    #code-stack .code-text[hidden] { display: none; }
    .code-text .cl { width: max-content; min-width: 100%; padding: 0 12px; white-space: pre; tab-size: 4; }
    .code-text .cl::before { content: attr(data-n); display: inline-block; width: var(--gutter, 4ch); margin-right: 16px; text-align: right; color: var(--muted); user-select: none; }
    .code-text .cl.hit { background: color-mix(in srgb, var(--accent) 16%, transparent); box-shadow: inset 3px 0 0 var(--accent); }
    #code-stack .said { margin: 0; padding: 14px 16px; font: 13.5px/1.5 var(--sans); white-space: normal; color: var(--muted); }
    .code-text .tk-k { color: var(--syn-keyword); } .code-text .tk-s { color: var(--syn-string); } .code-text .tk-n { color: var(--syn-number); } .code-text .tk-c { color: var(--muted); }
    #panel .code-pick { margin: 6px 0 10px; font-size: 13.5px; overflow-wrap: anywhere; }
  `;
  document.head.append(style);
}

const codeTabsEl = Object.assign(document.createElement("div"), { id: "code-tabs", hidden: true });
codeTabsEl.setAttribute("role", "tablist");
codeTabsEl.setAttribute("aria-label", "Open files");
const codeHead = Object.assign(document.createElement("div"), { id: "code-head", hidden: true });
const codeStack = Object.assign(document.createElement("div"), { id: "code-stack" });
$("pane-code").append(codeTabsEl, codeHead, codeStack);
$("pane-code").dataset.selectionFix = ""; // text selected here may also be fixed by the Builder (54-select.js)

const CODE_EMPTY = "Choose a file in Files, or select a class, function or module on Components and press View code.";
const codeEmptyEl = Object.assign(document.createElement("p"), { className: "said", textContent: CODE_EMPTY });
codeStack.append(codeEmptyEl);

// One tab per file: { id, focus: what to ask the core for ({ node, step } or { path }), path (in the Project, once known), status (of the last read),
// gone (the file or Node does not exist any more), hit ({ line, endLine } highlighted), scroll, stale (changed on disk since it was read), el, button, wrap }.
const codeTabs = [];
const codeRecent = []; // tabs, the one shown last
let codeActive = null;
let codeSelected = null; // the Node selected on Components; "View code" opens it
let codeRequest = 0; // numbers the opens so the last one chosen is the one shown
let codeProject = null;
let codeTabCount = 0;

// Syntax colours. ponytail: a line at a time with one regular expression per language, so a string or comment that spans lines is coloured wrongly
// after its first line; a real parser per language is the upgrade if that bothers anyone. Files over 4000 lines and lines over 1000 characters are shown plain.
const codeWords = (w) => `\\b(?:${w.trim().split(/\s+/).join("|")})\\b`;
const codeLanguages = {
  python: { ext: ["py", "pyw"], comment: "#", words: "False None True and as assert async await break class continue def del elif else except finally for from global if import in is lambda nonlocal not or pass raise return try while with yield" },
  script: { ext: ["js", "mjs", "cjs", "jsx", "ts", "tsx", "mts", "cts"], comment: "//", words: "abstract as async await break case catch class const continue debugger default delete do else enum export extends false finally for from function if implements import in instanceof interface let new null of private protected public readonly return static super switch this throw true try type typeof undefined var void while with yield" },
};
for (const l of Object.values(codeLanguages)) l.re = new RegExp(`(${l.comment}.*$)|("(?:\\\\.|[^"\\\\])*"|'(?:\\\\.|[^'\\\\])*'|\`(?:\\\\.|[^\`\\\\])*\`)|(\\b0[xX][\\da-fA-F_]+\\b|\\b\\d[\\d_.]*(?:[eE][+-]?\\d+)?\\b)|((?<!\\.)${codeWords(l.words)})`, "g");
const codeLanguageOf = (file) => Object.values(codeLanguages).find((l) => l.ext.includes(file.slice(file.lastIndexOf(".") + 1).toLowerCase()));
// The pieces of one line: [class, text] pairs, "" for plain text.
function codeSegments(text, language) {
  const out = [];
  let at = 0;
  for (const m of text.matchAll(language.re)) {
    if (m.index > at) out.push(["", text.slice(at, m.index)]);
    out.push([m[1] !== undefined ? "tk-c" : m[2] !== undefined ? "tk-s" : m[3] !== undefined ? "tk-n" : "tk-k", m[0]]);
    at = m.index + m[0].length;
  }
  if (at < text.length) out.push(["", text.slice(at)]);
  return out;
}

// The editor choice for this Project (one picker for the whole panel) and the button that opens the file shown in it. The template is typed by the
// person and checked by the core; the file and line sent are those of the tab shown.
const codeEditor = (() => {
  const btn = Object.assign(document.createElement("button"), { type: "button", textContent: "Open in my editor" });
  btn.onclick = async () => {
    if (!codeActive?.path) return;
    try {
      const r = await fetch("/open-in-editor", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ project: current, file: codeActive.path, line: codeActive.hit?.line ?? 1 }) });
      $("error").textContent = r.ok ? "" : (await r.json()).error;
    } catch { $("error").textContent = "Could not reach aidea to open the editor."; }
  };
  const picker = document.createElement("select");
  picker.className = "agent-opt";
  picker.setAttribute("aria-label", "Editor to open the code in");
  picker.disabled = true;
  const template = Object.assign(document.createElement("input"), { type: "text", placeholder: "my-editor --line {line} {file}", hidden: true });
  template.setAttribute("aria-label", "Command for your editor; {file} is the file and {line} the line");
  const note = Object.assign(document.createElement("div"), { className: "note", hidden: true });
  const save = async () => {
    const body = { project: current, editor: picker.value, template: template.value };
    const r = await fetch("/editor-setting", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    note.hidden = r.ok;
    note.textContent = r.ok ? "" : (await r.json()).error;
  };
  picker.onchange = () => { template.hidden = picker.value !== "custom"; if (picker.value !== "custom") save(); };
  template.onchange = save;
  // Reads the Project's choice; the controls stay off until it arrives.
  const load = (project) => {
    picker.disabled = true;
    fetch(`/editor-setting?project=${encodeURIComponent(project)}`).then((r) => r.ok ? r.json() : null).then((s) => {
      if (!s || project !== current) return;
      picker.replaceChildren(...s.editors.map((e) => Object.assign(document.createElement("option"), { value: e.id, textContent: e.label })));
      picker.value = s.editor;
      template.value = s.template;
      template.hidden = s.editor !== "custom";
      picker.disabled = false;
    }).catch(() => {});
  };
  return { controls: [picker, btn, template, note], load };
})();

const codeName = (tab) => tab.path ?? (tab.focus.path ?? tab.focus.node.split(".").pop());
const codeBase = (name) => name.slice(name.lastIndexOf("/") + 1);

// The head above the text: the file, its highlighted lines, and the editor controls when there is a file to open.
function codeHeadFor(tab) {
  codeHead.hidden = !tab || tab.gone || !tab.path;
  if (codeHead.hidden) return;
  const where = Object.assign(document.createElement("div"), { className: "where" });
  where.append(Object.assign(document.createElement("strong"), { textContent: tab.path }));
  if (tab.hit) where.append(Object.assign(document.createElement("span"), { className: "lines", textContent: tab.hit.endLine > tab.hit.line ? `lines ${tab.hit.line} to ${tab.hit.endLine}` : `line ${tab.hit.line}` }));
  codeHead.replaceChildren(where, ...codeEditor.controls);
}

// The labels of the tabs: the file's name, or its whole path when two open files share a name.
function codeLabels() {
  for (const tab of codeTabs) {
    const name = codeName(tab);
    const twin = codeTabs.some((o) => o !== tab && codeBase(codeName(o)) === codeBase(name));
    tab.button.textContent = twin ? name : codeBase(name);
    tab.button.title = name;
    tab.wrap.classList.toggle("gone", !!tab.gone);
    tab.close.setAttribute("aria-label", `Close ${name}`);
  }
}

// What the tab shows, from the core's answer: the text with line numbers, or a plain sentence.
function codeFill(tab, focus, r) {
  tab.focus = focus;
  tab.status = r.status;
  tab.gone = false;
  tab.stale = false;
  if (r.ok) {
    const { body } = r;
    tab.path = body.file;
    const rows = body.text.split(/\r?\n/);
    if (rows.length > 1 && rows[rows.length - 1] === "") rows.pop();
    // A file read again without lines keeps the ones it had, while the file still reaches them.
    tab.hit = body.line ? { line: body.line, endLine: body.endLine } : focus.path !== undefined && tab.hit && tab.hit.endLine <= rows.length ? tab.hit : null;
    const language = rows.length <= 4000 ? codeLanguageOf(body.file) : undefined;
    tab.el.style.setProperty("--gutter", `${Math.max(3, String(rows.length).length)}ch`);
    const frag = document.createDocumentFragment();
    rows.forEach((text, i) => {
      const row = Object.assign(document.createElement("div"), { className: tab.hit && i + 1 >= tab.hit.line && i + 1 <= tab.hit.endLine ? "cl hit" : "cl" });
      if (language && text.length <= 1000) row.append(...codeSegments(text, language).map(([cls, part]) => (cls ? Object.assign(document.createElement("span"), { className: cls, textContent: part }) : document.createTextNode(part))));
      else row.textContent = text;
      row.dataset.n = i + 1;
      frag.append(row);
    });
    tab.el.replaceChildren(frag);
  } else {
    if (focus.path !== undefined) tab.path = focus.path;
    tab.hit = null;
    // The file is not on disk any more: say so in a sentence; the tab stays so the person can close it, or press Refresh after putting the file back.
    codeSay(tab, r.status === 404 && focus.path !== undefined ? `${focus.path} is gone: it was moved, renamed or deleted. Close this tab, or press Refresh if you put it back.` : r.body.error, r.status === 404);
  }
  codeLabels();
}

// A plain sentence in the tab (a file that cannot be shown, a Node or file that is gone).
function codeSay(tab, text, gone = false) {
  tab.gone = gone;
  const p = Object.assign(document.createElement("p"), { className: "said", textContent: text });
  p.setAttribute("role", "status");
  tab.el.replaceChildren(p);
}

function codeNewTab(key) {
  const id = ++codeTabCount;
  const el = Object.assign(document.createElement("div"), { className: "code-text", tabIndex: 0, hidden: true });
  el.id = `code-text-${id}`;
  el.setAttribute("role", "tabpanel");
  el.setAttribute("aria-labelledby", `code-tab-${id}`);
  const button = Object.assign(document.createElement("button"), { type: "button", id: `code-tab-${id}`, tabIndex: -1 });
  button.setAttribute("role", "tab");
  button.setAttribute("aria-controls", el.id);
  button.setAttribute("aria-selected", "false");
  const close = Object.assign(document.createElement("button"), { type: "button", className: "code-close", textContent: "×", tabIndex: -1 });
  const wrap = Object.assign(document.createElement("div"), { className: "code-tab" });
  wrap.setAttribute("role", "presentation");
  wrap.append(button, close);
  const tab = { id, key, focus: null, path: null, status: 0, gone: false, hit: null, scroll: { top: 0, left: 0 }, stale: false, el, button, close, wrap };
  el.onscroll = () => { if (el.offsetParent !== null) tab.scroll = { top: el.scrollTop, left: el.scrollLeft }; }; // a hidden element has no real position to remember
  button.onclick = () => codeActivate(tab);
  button.onauxclick = (e) => { if (e.button === 1) codeClose(tab); };
  close.onclick = () => codeClose(tab);
  codeTabs.push(tab);
  codeTabsEl.append(wrap);
  codeStack.append(el);
  return tab;
}

function codeActivate(tab) {
  codeActive = tab;
  codeRecent.splice(0, codeRecent.length, ...codeRecent.filter((t) => t !== tab), tab);
  for (const t of codeTabs) {
    t.el.hidden = t !== tab;
    t.wrap.classList.toggle("on", t === tab);
    t.button.setAttribute("aria-selected", String(t === tab));
    t.button.tabIndex = t === tab ? 0 : -1;
  }
  codeEmptyEl.hidden = true;
  codeTabsEl.hidden = false;
  codeHeadFor(tab);
  tab.button.scrollIntoView?.({ block: "nearest", inline: "nearest" });
  codeRestore(tab, false);
  document.dispatchEvent(new CustomEvent("code-tab-changed", { detail: { path: tab.path, node: tab.focus?.node ?? null } }));
  // A tab that may differ from the disk (Refresh was pressed while another tab was shown) is read again as it comes back.
  if (tab.stale) { tab.stale = false; codeReload(tab); }
}

// Puts the tab back where it was, or, for lines just chosen, brings them into view (the panel must be on screen for the measures to mean anything).
function codeRestore(tab, toHit) {
  const first = toHit ? tab.el.querySelector(".hit") : null;
  if (first) tab.scroll = { top: Math.max(0, first.offsetTop - tab.el.clientHeight / 3), left: 0 };
  tab.el.scrollTop = tab.scroll.top;
  tab.el.scrollLeft = tab.scroll.left;
}

function codeClose(tab) {
  const at = codeTabs.indexOf(tab), wasActive = tab === codeActive, hadFocus = tab.wrap.contains(document.activeElement);
  codeTabs.splice(at, 1);
  codeRecent.splice(codeRecent.indexOf(tab), 1);
  tab.wrap.remove();
  tab.el.remove();
  if (wasActive) {
    const back = codeRecent.at(-1);
    if (back) { codeActivate(back); if (hadFocus) back.button.focus(); }
    else codeEmpty();
  }
  codeLabels();
}

function codeEmpty() {
  codeActive = null;
  codeTabsEl.hidden = true;
  codeHeadFor(null);
  codeEmptyEl.hidden = false;
  document.dispatchEvent(new CustomEvent("code-tab-changed", { detail: { path: null } }));
}

codeTabsEl.onkeydown = (e) => {
  const tab = codeTabs.find((t) => t.button === e.target);
  if (!tab || e.ctrlKey || e.metaKey || e.altKey) return;
  const at = codeTabs.indexOf(tab);
  const to = { ArrowRight: codeTabs[(at + 1) % codeTabs.length], ArrowLeft: codeTabs[(at - 1 + codeTabs.length) % codeTabs.length], Home: codeTabs[0], End: codeTabs.at(-1) }[e.key];
  if (to) { codeActivate(to); to.button.focus(); } else if (e.key === "Delete") codeClose(tab);
  else return;
  e.preventDefault();
};

// Asks the core for a Node's file, or a file by its path. `range` ({from, to}) comes from a step of a Flow.
async function codeFetch(focus, range) {
  const target = focus.path !== undefined ? `file=${encodeURIComponent(focus.path)}` : `node=${encodeURIComponent(focus.node)}&whole=1`;
  const res = await fetch(`/source?project=${encodeURIComponent(current)}&${target}${range ? `&from=${range.from}&to=${range.to}` : ""}`);
  return { ok: res.ok, status: res.status, body: await res.json() };
}

// The tab for what was asked: the one that already holds this file, else a new one.
const codeTabFor = (focus, r) => {
  const key = r.ok ? r.body.file : focus.path ?? `node:${focus.node}`;
  return codeTabs.find((t) => t.key === key || (focus.path !== undefined && t.path === focus.path)) ?? codeNewTab(key);
};

// Shows the panel (a drawer in a narrow window) and the highlighted lines in it.
async function codeShow(tab, toHit) {
  layoutShowPane("code");
  await new Promise((done) => requestAnimationFrame(done)); // the card has its size once the layout has been applied
  if (codeActive === tab) codeRestore(tab, toHit);
}

async function codeOpenFocus(focus, range) {
  if (!current) return false;
  const project = current, request = ++codeRequest;
  // A file that is already open and still as it was read is shown as it is, with the lines and place it had.
  const open = focus.path !== undefined && !range && codeTabs.find((t) => t.path === focus.path && t.status === 200 && !t.stale);
  let tab = open, ok = true;
  if (!tab) {
    const r = await codeFetch(focus, range);
    if (project !== current || request !== codeRequest) return false; // another Project, or a newer choice, owns the panel: no tab is left behind for this one
    tab = codeTabFor(focus, r);
    codeFill(tab, focus, r);
    ok = r.ok;
  }
  if (request !== codeRequest) return false; // a newer choice owns the panel
  codeActivate(tab);
  await codeShow(tab, ok && !open && !!tab.hit);
  return ok;
}

// Opens the panel on a Node's code; `step` marks it as the lines of a Flow step.
const codeOpen = (nodeId, range, step = null) => codeOpenFocus({ node: nodeId, step }, range);

// Opens the panel on a file by its path in the Project (what the Files panel knows), optionally with lines to highlight.
const codeOpenFile = (path, range) => codeOpenFocus({ path }, range);

// Reads one tab again from disk. A step's lines are the graph's: they are kept only while that Flow is still the one open.
async function codeReload(tab, nodes) {
  const { node, step, path } = tab.focus, project = current;
  if (path === undefined && nodes && !nodes.some((n) => n.id === node)) {
    codeSay(tab, `${node.split(".").pop()} is not in the code any more: it was moved, renamed or deleted. Select another on Components.`, true);
    codeLabels();
    if (tab === codeActive) codeHeadFor(tab);
    return;
  }
  const s = step && algoGraph && algoOpenId === step.algo ? algoGraph.steps.find((x) => x.id === step.id) : null;
  const focus = path !== undefined ? { path } : { node, step: s ? step : null };
  const r = await codeFetch(focus, s ? { from: s.line, to: s.endLine ?? s.line } : undefined);
  if (project !== current || !codeTabs.includes(tab)) return;
  const { scrollTop, scrollLeft } = tab.el;
  codeFill(tab, focus, r);
  if (tab === codeActive) { codeHeadFor(tab); tab.el.scrollTop = scrollTop; tab.el.scrollLeft = scrollLeft; }
}

// A refresh reads the shown tab again; the others are read when they are shown next.
async function codeRefresh(nodes) {
  for (const tab of codeTabs) if (tab !== codeActive) tab.stale = true;
  if (codeActive) await codeReload(codeActive, nodes);
}

// Selecting a Node opens its code at once when the Code panel is on screen (nothing opens the panel by itself); otherwise the Details offer "View code".
// `fromCode` is a selection made from the code side (57-reading.js): the code is already shown.
function onSelect(nodeId, fromCode = false) {
  if (!current) return;
  codeSelected = nodeId;
  const n = algoNodes.find((x) => x.id === nodeId);
  const view = Object.assign(document.createElement("button"), { type: "button", textContent: "View code" });
  view.setAttribute("aria-label", `View the code of ${n?.name ?? nodeId}`);
  view.onclick = () => codeOpen(nodeId);
  $("panel").replaceChildren(
    Object.assign(document.createElement("h2"), { textContent: n?.kind ?? "Selected" }),
    Object.assign(document.createElement("p"), { className: "code-pick", textContent: n?.name ?? nodeId }),
    view,
  );
  if (!fromCode && layoutShown.code) codeOpen(nodeId);
}

// A different Project starts with no tab open.
const drawWithoutCode = draw;
draw = async (nodes) => {
  if (codeProject !== current) {
    codeProject = current;
    codeSelected = null;
    codeRequest++;
    for (const tab of codeTabs.splice(0)) { tab.wrap.remove(); tab.el.remove(); }
    codeRecent.length = 0;
    codeEmpty();
    if (current) codeEditor.load(current);
  }
  await drawWithoutCode(nodes);
};

// A card that was hidden loses its scroll: when the panel comes back on screen (from the Panels menu, say) the tab shown is put back where it was.
let codeWasOnScreen = false;
document.addEventListener("layout-applied", () => {
  const now = layoutShown.code || layoutDrawer === "code";
  if (now && !codeWasOnScreen && codeActive) codeRestore(codeActive, false);
  codeWasOnScreen = now;
});

</script>
<script>
// Files panel: the folder hierarchy of the open Project (GET /files), a tree whose folders open and close. It is read-only and shows what the
// core lists: ignored folders (dependencies, caches, build output, version control) stay closed, a file in a language aidea can read says which.
// The tree is asked for only while the panel is on screen, because the core reads the folder to answer. Names are prefixed "files".
// Keys (ARIA tree): Up and Down move between rows, Right opens a folder or enters it, Left closes it or goes to its parent, Enter and Space toggle a folder
// or choose a file: choosing a file shows its text in a tab of the Code panel (55-code.js), and the file of the tab shown there is the one marked.
{
  const style = document.createElement("style");
  style.textContent = `
    #pane-files { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 8px 0; }
    #pane-files .files-note { padding: 8px 14px; font-size: 12px; color: var(--muted); }
    #pane-files ul { list-style: none; margin: 0; padding: 0; }
    #pane-files ul[hidden] { display: none; }
    #pane-files li:focus-visible { outline: none; }
    #pane-files li:focus-visible > .files-row { outline: 2px solid var(--accent); outline-offset: -2px; }
    #pane-files .files-row { display: flex; align-items: center; gap: 6px; min-height: 26px; padding: 2px 14px 2px calc(14px + var(--depth) * 14px); color: var(--text); font: 13px var(--sans); }
    #pane-files li[aria-expanded] > .files-row:not(.files-ignored), #pane-files li[data-kind="file"] > .files-row { cursor: pointer; }
    #pane-files li[aria-expanded] > .files-row:not(.files-ignored):hover, #pane-files li[data-kind="file"] > .files-row:hover { background: var(--raised); }
    #pane-files li[aria-selected="true"] > .files-row { background: var(--selected); box-shadow: inset 3px 0 0 var(--accent); }
    #pane-files .files-caret { flex: none; width: 10px; font-size: 11px; color: var(--muted); }
    #pane-files .files-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #pane-files .files-tag { flex: none; font-size: 12px; color: var(--muted); }
    #pane-files .files-plain .files-name, #pane-files .files-ignored .files-name { color: var(--muted); }
    #pane-files .files-ignored .files-name { font-style: italic; }
    #pane-files .files-aside { padding: 2px 14px 2px calc(14px + var(--depth) * 14px); font-size: 12px; color: var(--muted); }
  `;
  document.head.append(style);
}

const filesPane = $("pane-files");
const filesOpenFolders = new Set(); // the folders the person opened, kept while the tree is read again
let filesLoadedFor = null; // the Project whose tree is on screen
let filesFailedFor = null; // the Project whose last read failed: it is not tried again until something changes
let filesSelected = null; // the path of the file chosen, shown in the Code panel
let filesLoading = false; // a read is under way: nothing starts a second one
let filesStale = true; // what is on screen may differ from the disk (the Project was opened or refreshed)

const filesEl = (tag, props = {}, ...children) => { const e = Object.assign(document.createElement(tag), props); e.append(...children); return e; };

function filesNote(text) { filesPane.replaceChildren(filesEl("p", { className: "files-note", textContent: text })); }

// A line that is not an entry (an empty folder, entries left out): it sits in the tree but is not a row to move to.
function filesAside(text, depth) {
  const li = filesEl("li", { className: "files-aside", textContent: text });
  li.setAttribute("role", "treeitem");
  li.setAttribute("aria-disabled", "true");
  li.style.setProperty("--depth", depth);
  return li;
}

function filesRow(entry, depth) {
  const li = filesEl("li", { tabIndex: -1 });
  li.setAttribute("role", "treeitem");
  li.dataset.path = entry.path;
  li.dataset.kind = entry.kind;
  const tag = entry.kind === "file" && entry.language ? [filesEl("span", { className: "files-tag", textContent: entry.language })] : [];
  const ignored = entry.ignored === true;
  const caret = filesEl("span", { className: "files-caret", textContent: entry.kind === "folder" && !ignored ? "▸" : "" });
  caret.setAttribute("aria-hidden", "true");
  const title = ignored ? `${entry.path}: listed, not opened (dependencies, caches, build output or version control)` : entry.path;
  const row = filesEl("div", { className: `files-row${ignored ? " files-ignored" : ""}${entry.kind === "file" && !entry.analysed ? " files-plain" : ""}`, title }, caret, filesEl("span", { className: "files-name", textContent: entry.name }), ...tag);
  row.style.setProperty("--depth", depth);
  li.append(row);
  if (entry.kind === "file") {
    li.setAttribute("aria-selected", String(entry.path === filesSelected));
    li.chooseFile = () => filesChoose(entry.path);
    row.onclick = () => { li.focus(); li.chooseFile(); };
    return li;
  }
  if (ignored) return li;
  let group = null;
  li.openFolder = (open) => {
    li.setAttribute("aria-expanded", String(open));
    caret.textContent = open ? "▾" : "▸";
    if (open) filesOpenFolders.add(entry.path); else filesOpenFolders.delete(entry.path);
    if (open && !group) { group = filesList(entry, depth + 1); li.append(group); } // children are drawn the first time the folder opens, so a huge tree costs nothing until it is opened
    if (group) group.hidden = !open;
  };
  row.onclick = () => { li.focus(); li.openFolder(li.getAttribute("aria-expanded") !== "true"); };
  li.openFolder(filesOpenFolders.has(entry.path));
  return li;
}

function filesList(folder, depth) {
  const ul = filesEl("ul", {});
  ul.setAttribute("role", "group");
  const children = folder.children ?? [];
  if (folder.unread) ul.append(filesAside("Not listed: this Project has too many files to read them all.", depth));
  else if (!children.length && !folder.truncated) ul.append(filesAside("Empty", depth));
  for (const child of children) ul.append(filesRow(child, depth));
  if (folder.truncated) ul.append(filesAside(`${folder.truncated} more entries are not shown. Open the folder in your editor to see them.`, depth));
  return ul;
}

// Chooses a file: it is marked and its text opens in the Code panel.
function filesChoose(path) {
  filesMark(path);
  codeOpenFile(path);
}

// Marks the file whose text the Code panel shows; the Code panel says when its tab changes (a tab chosen there, a Node's file, a tab closed).
function filesMark(path) {
  filesSelected = path;
  for (const li of filesPane.querySelectorAll("li[data-kind='file']")) li.setAttribute("aria-selected", String(li.dataset.path === path));
}
document.addEventListener("code-tab-changed", (e) => filesMark(e.detail.path));

// The rows the person can move to now: entries whose folders are all open.
const filesRows = (tree) => [...tree.querySelectorAll("li[data-path]")].filter((li) => li.offsetParent !== null);

function filesKey(tree, e) {
  const li = e.target.closest("li[data-path]");
  if (!li || e.ctrlKey || e.metaKey || e.altKey) return;
  const rows = filesRows(tree), at = rows.indexOf(li);
  const folder = !!li.openFolder, open = li.getAttribute("aria-expanded") === "true";
  const go = (row) => row?.focus();
  switch (e.key) {
    case "ArrowDown": go(rows[at + 1]); break;
    case "ArrowUp": go(rows[at - 1]); break;
    case "Home": go(rows[0]); break;
    case "End": go(rows.at(-1)); break;
    case "ArrowRight": if (folder && !open) li.openFolder(true); else if (folder) go(rows[at + 1]); break;
    case "ArrowLeft": if (folder && open) li.openFolder(false); else go(li.parentElement.closest("li[data-path]")); break;
    case "Enter": case " ": if (folder) li.openFolder(!open); else li.chooseFile(); break;
    default: return;
  }
  e.preventDefault();
}

async function filesLoad() {
  const project = current;
  if (!project) { filesLoadedFor = null; filesNote("Open a Project to see its files."); return; }
  filesLoading = true;
  filesStale = false; // a refresh that arrives during the read makes it true again, and the read is repeated
  if (filesLoadedFor !== project) filesNote("Reading the files...");
  try {
    const res = await fetch(`/files?project=${encodeURIComponent(project)}`);
    const body = await res.json();
    if (project !== current) return; // another Project was opened meanwhile: filesEnsure reads that one
    if (!res.ok) { filesLoadedFor = null; filesFailedFor = project; filesNote(body.error ?? "The files could not be read."); return; }
    if (filesLoadedFor !== project) { filesOpenFolders.clear(); filesSelected = null; } // another Project: its folders start closed and no file is chosen
    const kept = { scroll: filesPane.scrollTop, focus: document.activeElement?.closest?.("#pane-files li[data-path]")?.dataset.path };
    filesLoadedFor = project;
    filesFailedFor = null;
    const tree = filesList({ children: body.root, truncated: body.truncated }, 0);
    tree.setAttribute("role", "tree");
    tree.setAttribute("aria-label", "Project files");
    tree.onkeydown = (e) => filesKey(tree, e);
    tree.onfocusin = (e) => { for (const li of tree.querySelectorAll("li[tabindex='0']")) li.tabIndex = -1; const row = e.target.closest?.("li[data-path]"); if (row) row.tabIndex = 0; };
    filesPane.replaceChildren(tree);
    filesPane.scrollTop = kept.scroll; // a refresh keeps the place the person was at
    const first = tree.querySelector("li[data-path]");
    const back = kept.focus && [...tree.querySelectorAll("li[data-path]")].find((li) => li.dataset.path === kept.focus);
    (back ?? first)?.setAttribute("tabindex", "0"); // one stop for Tab: the row that had the focus, else the first
    if (back) back.focus();
  } catch {
    if (project === current) { filesLoadedFor = null; filesFailedFor = project; filesNote("Could not reach aidea to read the files."); }
  } finally {
    filesLoading = false;
    filesEnsure(); // the Project changed or was refreshed while this read ran
  }
}

// Reads the tree when the panel is on screen (or open as a drawer) and what it shows is missing or out of date.
// A failed read is not repeated by itself: layout changes fire this often, so only a new Project or a refresh tries again.
function filesEnsure() {
  const onScreen = typeof layoutShown !== "undefined" && (layoutShown.files || layoutDrawer === "files");
  if (!onScreen || filesLoading || !current) return; // with no Project the panel already says so
  if (!filesStale && (filesLoadedFor === current || filesFailedFor === current)) return;
  filesLoad();
}

document.addEventListener("project-opened", () => { filesStale = true; filesFailedFor = null; filesEnsure(); });
document.addEventListener("project-refreshed", () => { filesStale = true; filesFailedFor = null; filesEnsure(); });
document.addEventListener("layout-applied", filesEnsure);
filesNote("Open a Project to see its files.");

</script>
<script>
// The Node whose code is being read shows it (layout-and-data 05). Files, Nodes and the steps of a Flow select each other through the Code panel: when a tab of the Code panel comes to the
// front (a file chosen in Files, "View code" on a Node, a step of a Flow), the Node it belongs to carries a sign on the Canvas: a thick ring and the word READING, so it reads without colour.
// One Node at a time. A file that is not a Node on the Canvas clears it, and so does a layer where the Node is not drawn. Names are prefixed "reading" because every feature file shares one global scope.
{
  const style = document.createElement("style");
  style.textContent = `
    #world .reading { stroke: var(--accent); stroke-width: 3; }
    #world .reading-tag { fill: var(--accent); font: 600 11px var(--sans); letter-spacing: .08em; pointer-events: none; }
  `;
  document.head.append(style);

  let readingId = null; // the Node whose code is on screen, whether or not the Canvas draws it now
  const onComponents = () => typeof authoredShown !== "string" || authoredShown === "components";

  function readingMark(id) {
    readingId = id;
    for (const n of document.querySelectorAll("#world .reading")) n.classList.remove("reading");
    for (const n of document.querySelectorAll("#world .reading-tag")) n.remove();
    if (!id || !onComponents()) return;
    const rects = [...document.querySelectorAll(`#world rect[data-id="${CSS.escape(id)}"]`)];
    if (!rects.length) return;
    for (const r of rects) r.classList.add("reading");
    const main = rects.find((r) => /cp-pkg|cp-class|cp-func/.test(r.getAttribute("class") ?? "")) ?? rects[0];
    $("world").append(el("text", { x: Number(main.getAttribute("x")) + Number(main.getAttribute("width")) - 4, y: Number(main.getAttribute("y")) - 5, class: "reading-tag", "text-anchor": "end" }, "READING"));
  }

  // The Node of what the Code panel shows: the Node it was opened for, else the module that is that file.
  document.addEventListener("code-tab-changed", (e) => {
    const { path, node } = e.detail ?? {};
    const found = node ?? (path ? algoNodes.find((n) => n.kind === "module" && n.file === path)?.id : null) ?? null;
    readingMark(found);
    if (found && typeof onSelect === "function" && codeSelected !== found) onSelect(found, true); // chosen from the code side: select it, without opening the code again
  });

  // The sign comes back after the Canvas is drawn again, and goes when another layer is shown.
  const readingDraw = draw;
  draw = async (nodes) => { await readingDraw(nodes); readingMark(readingId); };
  const readingShowLayer = showLayer;
  showLayer = (which) => { readingShowLayer(which); readingMark(readingId); };
}

</script>
<script>
// The Data layer (layout-and-data 14), next to Flow in the layer bar. While a function is played it draws the variables the recording holds at the step being shown (the core records their
// shape: Python today): a scalar as a labelled box, a list as a row of cells with their places, a dictionary as keys pointing to values, an object as a box with its fields. What the last step
// changed is marked in words (CHANGED) as well as by its look. Objects that point to objects (linked lists, trees, graphs, aliases, cycles; layout-and-data 15) are drawn as framed nodes with an arrow
// for every pointer, laid out as a tree from the variables; a pointer the last step set is a heavy arrow tagged NEW, the one it replaced a dashed arrow tagged WAS. Data follows the one Playback position with Flow, the Playback panel and the trace table. Nobody writes it. Names are prefixed
// "data" because every feature file shares one global scope.
{
  const dataGroup = el("g", { id: "data" });
  const dataTab = Object.assign(document.createElement("button"), { textContent: "Data", disabled: true, title: "Open a function's Flow first: Data draws its variables while it is played" });
  dataTab.dataset.layer = "data";
  dataTab.onclick = () => showLayer("data");
  // Two buttons that belong to this layer only (layout-and-data 17): the text form of each value beside the drawing, and the drawing saved as an image.
  let dataText = false;
  const dataTextButton = Object.assign(document.createElement("button"), { id: "data-text-toggle", textContent: "Text", hidden: true, title: "Write each variable's value as text beside the drawing" });
  dataTextButton.setAttribute("aria-pressed", "false");
  dataTextButton.onclick = () => { dataText = !dataText; dataTextButton.setAttribute("aria-pressed", String(dataText)); dataDraw(); };
  const dataSaveButton = Object.assign(document.createElement("button"), { id: "data-save-image", textContent: "Save image", hidden: true, title: "Save the drawing of this step as an SVG image" });
  dataSaveButton.onclick = () => {
    const url = URL.createObjectURL(new Blob([dataSvgText()], { type: "image/svg+xml" }));
    Object.assign(document.createElement("a"), { href: url, download: `aidea-data-step-${pbIndex + 1}.svg` }).click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  };
  layerBar.append(dataTab);
  $("zoom").prepend(dataTextButton, dataSaveButton); // with the zoom controls: the layer bar has no room left

  const style = document.createElement("style");
  style.textContent = `
    #layers [data-layer="data"] { order: 6; }
    #data { font-family: var(--mono); }
    #data .data-label { fill: var(--label); font: 13px var(--sans); text-anchor: end; }
    #data .data-pos { fill: var(--muted); font: 11px var(--mono); text-anchor: middle; }
    #data .data-box { fill: var(--raised); stroke: var(--control); stroke-width: 1.4; }
    #data .data-value { fill: var(--text); font: 12.5px var(--mono); text-anchor: middle; }
    #data .data-key { fill: var(--label); font: 12.5px var(--mono); text-anchor: middle; }
    #data .data-arrow { fill: var(--muted); font: 13px var(--sans); text-anchor: middle; }
    #data .data-hidden-cell { fill: none; stroke: var(--control); stroke-width: 1.4; stroke-dasharray: 4 3; }
    #data .data-hidden { fill: var(--muted); font: 12px var(--sans); text-anchor: middle; }
    #data .data-title { fill: var(--muted); font: 11px var(--mono); }
    #data .data-var.changed .data-box { stroke: var(--accent); stroke-width: 2.4; }
    #data .data-changed { fill: var(--accent); font: 600 11px var(--sans); letter-spacing: .08em; text-anchor: end; }
    #data .data-var.pointed .data-label { fill: var(--accent); font-weight: 600; }
    #data .data-var.pointed .data-box { stroke: var(--accent); stroke-width: 3; }
    #data .data-look { fill: var(--accent); font: 600 11px var(--sans); letter-spacing: .08em; text-anchor: end; }
    #data .data-note { fill: var(--muted); font: 13px var(--sans); }
    #data .data-textline { fill: var(--label); font: 12.5px var(--mono); }
    #zoom #data-text-toggle[hidden], #zoom #data-save-image[hidden] { display: none; }
    #zoom #data-text-toggle[aria-pressed="true"] { color: var(--accent); font-weight: 600; }
    #data .data-frame { fill: var(--bg); stroke: var(--line); stroke-width: 1; }
    #data .data-port { fill: var(--muted); }
    #data .data-cut { fill: var(--muted); font: 12px var(--sans); text-anchor: middle; }
    #data .data-edge, #data .data-edge-old { fill: none; stroke: var(--muted); stroke-width: 1.4; }
    #data .data-edge.rewired { stroke: var(--accent); stroke-width: 2.6; }
    #data .data-edge-old { stroke: var(--accent); stroke-width: 1.6; stroke-dasharray: 5 4; }
    #data .data-edge-tag { fill: var(--accent); font: 600 11px var(--sans); letter-spacing: .08em; text-anchor: middle; paint-order: stroke; stroke: var(--bg); stroke-width: 4px; }
    #data .data-head { fill: var(--muted); }
    #data .data-head-hot { fill: var(--accent); }
  `;
  document.head.append(style);

  const LABEL = 120, CELL = 30, PAD = 8, ROW = 22, EXTRA = 16, FRAME = 8, GAP = 16, COLGAP = 90, PORT = 26;
  const CUT_DEPTH = 6, CUT_NODES = 500; // the core's limits (src/core/playback.py), stated on every cut
  const widthOf = (text) => Math.max(40, Math.round(text.length * 7.6) + 18);
  const plain = (n) => n.toLocaleString("en-US");

  // The text of a scalar the way Python writes it. A value the core could not give as a number (nan, a huge integer) carries its own text.
  function scalarText(s) {
    const v = s.value;
    if (v !== null && typeof v === "object") return v.digits ? `${String(v.value).slice(0, 12)}… (${plain(v.digits)} digits)` : String(v.value);
    if (v === null || s.type === "NoneType") return "None";
    if (typeof v === "boolean") return v ? "True" : "False";
    if (typeof v === "string") return `'${v}'${s.hidden ? "…" : ""}`;
    return String(v);
  }
  // One line for a value that sits inside another (an item, a key, a field): a scalar in full, a container by its size.
  function summary(s) {
    if (!s) return "";
    if (s.kind === "scalar") return scalarText(s);
    if (s.kind === "seq") return `${s.type}[${plain((s.len ?? s.items?.length ?? 0))}]`;
    if (s.kind === "map") return `${s.type}{${plain(s.len ?? s.entries?.length ?? 0)}}`;
    if (s.kind === "object") return s.type ?? "object";
    if (s.kind === "ref") return `→ #${s.id}`;
    if (s.kind === "cut") return cutText(s);
    return "…";
  }
  const cutText = (s) => (s.reason === "depth" ? `cut: depth limit (${CUT_DEPTH} levels)` : `cut: node limit (${CUT_NODES} values per step)`);

  // What can be drawn as a node: a list, set, dictionary or object that has an identity (tuples and numbers have none).
  const isNode = (s) => !!s && s.id !== undefined && (s.kind === "seq" || s.kind === "map" || s.kind === "object");
  // The places in a node that can hold a value: [slot, value]. A dictionary's slot is its entry number.
  const slotsOf = (n) => (n.kind === "seq" ? (n.items ?? []).map((v, i) => [String(i), v]) : n.kind === "map" ? (n.entries ?? []).map(([, v], i) => [String(i), v]) : Object.entries(n.fields ?? {}));
  // A value is a pointer when it names an object elsewhere (a ref, or a cut that is described somewhere in this step), or is an object, or a container held by an object. A list or dictionary
  // inside another list or dictionary stays one line of text, as before.
  const linkId = (parent, v, nodes) => {
    const id = !v ? null : v.kind === "ref" || v.kind === "cut" ? v.id : isNode(v) && (v.kind === "object" || parent === "object") ? v.id : null;
    return id !== undefined && id !== null && nodes.has(id) ? id : null;
  };
  // Reads one step's shapes: the nodes, the pointers between them, and the variables that are drawn as nodes. Used for the step shown and for the one before it.
  function dataScan(shapes) {
    const nodes = new Map(), edges = new Map(), adj = new Map(), targeted = new Set(), sources = new Set(), vars = new Map();
    const walk = (s) => {
      if (!isNode(s) || nodes.has(s.id)) return;
      nodes.set(s.id, s);
      for (const [, v] of slotsOf(s)) if (isNode(v) && (v.kind === "object" || s.kind === "object")) walk(v);
    };
    for (const v of Object.values(shapes ?? {})) walk(v);
    for (const n of nodes.values()) {
      const to = [];
      for (const [slot, v] of slotsOf(n)) {
        const id = linkId(n.kind, v, nodes);
        if (id === null) continue;
        edges.set(`${n.id}:${slot}`, id); to.push(id); targeted.add(id); sources.add(n.id);
      }
      adj.set(n.id, to);
    }
    for (const v of Object.values(shapes ?? {})) if (v.kind === "ref" && nodes.has(v.id)) targeted.add(v.id);
    // An object variable is always a node; a list or dictionary only when it is part of a pointer.
    for (const [name, v] of Object.entries(shapes ?? {})) {
      const id = v.kind === "ref" && nodes.has(v.id) ? v.id : isNode(v) && (v.kind === "object" || targeted.has(v.id) || sources.has(v.id)) ? v.id : null;
      if (id !== null) { vars.set(name, id); edges.set(`var:${name}`, id); }
    }
    return { nodes, edges, adj, vars };
  }
  let dataCtx = { nodes: new Map(), ports: null }; // the step being drawn; ports is where the pointers of the node being drawn start

  // One box with its text, at (x, y); returns where it ends.
  function cell(group, x, y, text, cls = "data-value", box = "data-box") {
    const w = widthOf(text);
    group.append(el("rect", { x, y, width: w, height: CELL, rx: 5, class: box }), el("text", { x: x + w / 2, y: y + CELL / 2 + 4.5, class: cls }, text));
    return w;
  }

  // The cell for one value held by a node: its text, a dot when it is a pointer (the arrow starts there), a dashed cell when the drawing was cut. Returns the cell's width.
  function slotCell(group, x, y, v, slot, parent, box = "data-box") {
    const to = dataCtx.ports ? linkId(parent, v, dataCtx.nodes) : null;
    if (to !== null) {
      group.append(el("rect", { x, y, width: PORT, height: CELL, rx: 5, class: `${box} data-port-cell` }), el("circle", { cx: x + PORT / 2, cy: y + CELL / 2, r: 4.5, class: "data-port" }));
      dataCtx.ports.set(slot, { x: x + PORT / 2, y: y + CELL / 2, to });
      return PORT;
    }
    if (v?.kind === "cut") {
      const text = cutText(v), w = widthOf(text) + 8;
      group.append(el("rect", { x, y, width: w, height: CELL, rx: 5, class: "data-hidden-cell" }), el("text", { x: x + w / 2, y: y + CELL / 2 + 4.5, class: "data-cut" }, text));
      return w;
    }
    return cell(group, x, y, summary(v), "data-value", box);
  }

  // Draws one value at (x, y) into `group` and returns its size.
  function drawValue(group, shape, x, y) {
    if (shape.kind === "seq") {
      const sc = el("g", { class: "data-seq" });
      let dx = 0;
      (shape.items ?? []).forEach((item, i) => {
        const w = slotCell(sc, x + dx, y + EXTRA - 2, item, String(i), shape.kind, "data-box data-cell");
        sc.append(el("text", { x: x + dx + w / 2, y: y + 11, class: "data-pos" }, String(i)));
        dx += w + 4;
      });
      if (shape.hidden > 0) {
        const text = `${plain(shape.hidden)} more hidden`, w = widthOf(text) + 8;
        sc.append(el("rect", { x: x + dx, y: y + EXTRA - 2, width: w, height: CELL, rx: 5, class: "data-hidden-cell" }), el("text", { x: x + dx + w / 2, y: y + EXTRA - 2 + CELL / 2 + 4.5, class: "data-hidden" }, text));
        dx += w;
      }
      if (!shape.items?.length && !shape.hidden) { sc.append(el("rect", { x, y: y + EXTRA - 2, width: 60, height: CELL, rx: 5, class: "data-hidden-cell" }), el("text", { x: x + 30, y: y + EXTRA - 2 + CELL / 2 + 4.5, class: "data-hidden" }, "empty")); dx = 60; }
      group.append(sc);
      return { width: dx, height: EXTRA - 2 + CELL };
    }
    if (shape.kind === "map") {
      const mc = el("g", { class: "data-map" });
      let dy = 0, maxW = 0;
      let entry = 0;
      for (const [k, v] of shape.entries ?? []) {
        const pair = el("g", { class: "data-pair" });
        const kw = cell(pair, x, y + dy, summary(k), "data-key");
        pair.append(el("text", { x: x + kw + 14, y: y + dy + CELL / 2 + 4.5, class: "data-arrow" }, "→"));
        const vw = slotCell(pair, x + kw + 28, y + dy, v, String(entry++), shape.kind);
        mc.append(pair);
        maxW = Math.max(maxW, kw + 28 + vw);
        dy += CELL + 6;
      }
      if (shape.hidden > 0) {
        const text = `${plain(shape.hidden)} more hidden`, w = widthOf(text) + 8;
        mc.append(el("rect", { x, y: y + dy, width: w, height: CELL, rx: 5, class: "data-hidden-cell" }), el("text", { x: x + w / 2, y: y + dy + CELL / 2 + 4.5, class: "data-hidden" }, text));
        maxW = Math.max(maxW, w);
        dy += CELL + 6;
      }
      if (!dy) { mc.append(el("rect", { x, y, width: 60, height: CELL, rx: 5, class: "data-hidden-cell" }), el("text", { x: x + 30, y: y + CELL / 2 + 4.5, class: "data-hidden" }, "empty")); maxW = 60; dy = CELL + 6; }
      group.append(mc);
      return { width: maxW, height: dy - 6 };
    }
    if (shape.kind === "object") {
      const oc = el("g", { class: "data-object" });
      oc.append(el("text", { x, y: y + 10, class: "data-title" }, shape.type ?? "object"));
      let dy = 16, maxW = 0;
      for (const [name, v] of Object.entries(shape.fields ?? {})) {
        const kw = cell(oc, x, y + dy, name, "data-key");
        oc.append(el("text", { x: x + kw + 14, y: y + dy + CELL / 2 + 4.5, class: "data-arrow" }, "→"));
        const vw = slotCell(oc, x + kw + 28, y + dy, v, name, shape.kind);
        maxW = Math.max(maxW, kw + 28 + vw);
        dy += CELL + 6;
      }
      group.append(oc);
      return { width: maxW, height: dy - 6 };
    }
    // A scalar, a reference to a value drawn elsewhere, or a part that was cut: one box.
    const sc = el("g", { class: shape.kind === "scalar" ? "data-scalar" : "data-other" });
    const w = cell(sc, x, y, summary(shape));
    group.append(sc);
    return { width: w, height: CELL };
  }

  // The plain statement in place of a drawing.
  const note = (text) => dataGroup.replaceChildren(el("text", { x: 0, y: 20, class: "data-note" }, text));

  // The variables that point to objects, and the objects, from `top` down: names in a column on the left, the objects laid out as a tree (a column per level, a parent between its children),
  // an arrow for every pointer. `before` is the step before this one: a pointer that is different from there is NEW, and the arrow it replaced is drawn dashed as WAS.
  function dataGraph(scan, before, linked, top) {
    // Roots first that no object points to (the head of a list, the root of a tree), so the structure reads left to right; the stable sort keeps the order of the variables.
    const pointed = new Set([...scan.edges].filter(([key]) => !key.startsWith("var:")).map(([, to]) => to));
    const roots = [...new Set(linked.map(([name]) => scan.vars.get(name)))].sort((a, b) => pointed.has(a) - pointed.has(b));
    const order = [], seen = new Set();
    const reach = (id) => { if (seen.has(id)) return; seen.add(id); order.push(id); for (const t of scan.adj.get(id) ?? []) reach(t); };
    roots.forEach(reach);
    // Each node is drawn once, at the origin, to learn its size and where its pointers start; it is moved when the layout is known.
    const boxes = new Map();
    for (const id of order) {
      dataCtx.ports = new Map();
      const g = el("g", { class: "data-node", "data-id": id }), frame = el("rect", { class: "data-frame", rx: 8 });
      g.append(frame);
      const size = drawValue(g, scan.nodes.get(id), FRAME, FRAME), w = size.width + 2 * FRAME, h = size.height + 2 * FRAME;
      frame.setAttribute("width", w); frame.setAttribute("height", h);
      boxes.set(id, { g, w, h, ports: dataCtx.ports });
    }
    dataCtx.ports = null;

    const level = new Map(), bottom = [];
    let next = 0;
    const place = (id, depth) => {
      const at = { depth, y: 0 }, kids = [];
      level.set(id, at);
      for (const t of scan.adj.get(id) ?? []) if (!level.has(t)) { place(t, depth + 1); kids.push(t); }
      const h = boxes.get(id).h, mid = (k) => level.get(k).y + boxes.get(k).h / 2;
      let yy = kids.length ? (mid(kids[0]) + mid(kids.at(-1))) / 2 - h / 2 : next;
      yy = Math.max(yy, bottom[depth] ?? 0);
      at.y = yy; bottom[depth] = yy + h + GAP; next = Math.max(next, yy + h + GAP);
    };
    roots.forEach((id) => { if (!level.has(id)) place(id, 0); });
    const widest = [];
    for (const [id, at] of level) widest[at.depth] = Math.max(widest[at.depth] ?? 0, boxes.get(id).w);
    const colX = [LABEL + 90];
    for (let d = 1; d < widest.length; d++) colX[d] = colX[d - 1] + widest[d - 1] + COLGAP;
    const spot = new Map();
    for (const [id, at] of level) spot.set(id, { x: colX[at.depth], y: top + at.y });

    // The arrows: from a name or a pointer's dot to the left edge of its object.
    const edges = el("g", { class: "data-edges" }), defs = el("defs", {});
    for (const cls of ["data-head", "data-head-hot"]) {
      const m = el("marker", { id: cls, viewBox: "0 0 12 12", refX: 11, refY: 6, markerWidth: 10, markerHeight: 10, markerUnits: "userSpaceOnUse", orient: "auto" });
      m.append(el("path", { d: "M1 1.5L11 6L1 10.5z", class: cls }));
      defs.append(m);
    }
    // A pointer that goes forward is an S; one that goes back (a cycle, a node that points to an earlier one) dips below both ends so it does not run over the forward arrows.
    const curve = (from, to) => {
      if (to.x <= from.x + 4) { const d = 70; return `M${from.x} ${from.y} C${from.x + 60} ${from.y + d} ${to.x - 60} ${to.y + d} ${to.x} ${to.y}`; }
      const dx = Math.max(40, Math.abs(to.x - from.x) / 2);
      return `M${from.x} ${from.y} C${from.x + dx} ${from.y} ${to.x - dx} ${to.y} ${to.x} ${to.y}`;
    };
    const landing = (id) => ({ x: spot.get(id).x, y: spot.get(id).y + boxes.get(id).h / 2 });
    const arrow = (key, from, to, label) => {
      const target = landing(to), was = before?.edges.get(key);
      const hot = !!before && (was !== undefined ? was !== to : !key.startsWith("var:") && before.nodes.has(Number(key.split(":")[0])));
      const path = el("path", { class: `data-edge${hot ? " rewired" : ""}`, d: curve(from, target), "data-from": key, "data-to": to, "marker-end": `url(#${hot ? "data-head-hot" : "data-head"})` });
      path.append(el("title", {}, `${label} points to #${to}${hot ? " (set by this step)" : ""}`));
      edges.append(path);
      const tag = (word, a, b) => edges.append(el("text", { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 - 6, class: "data-edge-tag" }, word));
      if (hot) tag("NEW", from, target);
      if (hot && was !== undefined && spot.has(was)) {
        const old = landing(was);
        edges.append(el("path", { class: "data-edge-old", d: curve(from, old), "data-from": key, "data-to": was, "marker-end": "url(#data-head-hot)" }));
        tag("WAS", from, old);
      }
    };
    for (const [id, b] of boxes) {
      const at = spot.get(id);
      b.g.setAttribute("transform", `translate(${at.x} ${at.y})`);
      for (const [slot, p] of b.ports) arrow(`${id}:${slot}`, { x: at.x + p.x, y: at.y + p.y }, p.to, slot);
    }
    const labels = el("g", { class: "data-names" });
    linked.forEach(([name, shape], i) => {
      const ly = top + i * (CELL + 24), row = el("g", { class: `data-var${shape.changed ? " changed" : ""}${name === dataPointed ? " pointed" : ""}`, "data-var": name });
      row.append(el("text", { x: LABEL, y: ly + CELL / 2 + 4.5, class: "data-label" }, name));
      if (name === dataPointed) row.append(el("text", { x: LABEL, y: ly + CELL / 2 - 11, class: "data-look" }, "LOOK HERE"));
      if (shape.changed) row.append(el("text", { x: LABEL, y: ly + CELL / 2 + 19, class: "data-changed" }, "CHANGED"));
      labels.append(row);
      arrow(`var:${name}`, { x: LABEL + 8, y: ly + CELL / 2 }, scan.vars.get(name), name);
    });
    dataGroup.append(defs, edges, labels, ...[...boxes.values()].map((b) => b.g));
    return Math.max(top + linked.length * (CELL + 24), ...[...spot].map(([id, p]) => p.y + boxes.get(id).h)) + ROW;
  }

  // The drawing as a standalone SVG: its own styles with the colours written out (the page's variables do not exist outside it), on the page's background.
  function dataSvgText() {
    const box = dataGroup.getBBox(), pad = 24, root = getComputedStyle(document.documentElement);
    const css = style.textContent.replace(/var\((--[\w-]+)\)/g, (_, name) => root.getPropertyValue(name).trim() || "currentColor");
    const svgEl = el("svg", { xmlns: NS, viewBox: `${box.x - pad} ${box.y - pad} ${box.width + 2 * pad} ${box.height + 2 * pad}`, width: Math.ceil(box.width + 2 * pad), height: Math.ceil(box.height + 2 * pad) });
    const copy = dataGroup.cloneNode(true);
    copy.removeAttribute("style");
    svgEl.append(el("style", {}, css), el("rect", { x: box.x - pad, y: box.y - pad, width: box.width + 2 * pad, height: box.height + 2 * pad, fill: root.getPropertyValue("--bg").trim() }), copy);
    return `<?xml version="1.0" encoding="UTF-8"?>\n${new XMLSerializer().serializeToString(svgEl)}`;
  }

  let dataPointed = null; // the variable the Tutor asked the person to look at (a prediction that points at Data)
  let dataFitted = false, dataFramed = { w: 0, h: 0 }; // the view is framed when the layer opens or the drawing outgrows the frame, not at every step
  function dataDraw() {
    if (authoredShown !== "data") return;
    const rec = pbRecording, entry = rec?.visits?.[pbIndex];
    if (!rec) return note("Press Play in the Playback panel: Data draws the variables of this function as it runs.");
    if (!entry) return note(rec.error ? `The run stopped before its first step: ${rec.error.type}.` : "Nothing was recorded.");
    if (!entry.shapes) {
      return note(rec.visits.some((v) => v.shapes) || rec.shapesTruncated
        ? "Too many values to draw: Data stops after the step where its budget ran out."
        : "This language does not record the values of a run for Data yet. Python functions do.");
    }
    dataGroup.replaceChildren();
    const scan = dataScan(entry.shapes), before = pbIndex > 0 && rec.visits[pbIndex - 1]?.shapes ? dataScan(rec.visits[pbIndex - 1].shapes) : null;
    dataCtx = { nodes: scan.nodes, ports: null };
    let y = 0, widest = 0;
    const linked = [];
    for (const [name, shape] of Object.entries(entry.shapes)) {
      if (scan.vars.has(name)) { linked.push([name, shape]); continue; }
      const row = el("g", { class: `data-var${shape.changed ? " changed" : ""}${name === dataPointed ? " pointed" : ""}`, "data-var": name });
      row.append(el("text", { x: LABEL, y: y + (shape.kind === "seq" ? EXTRA - 2 : 0) + CELL / 2 + 4.5, class: "data-label" }, name));
      if (name === dataPointed) row.append(el("text", { x: LABEL, y: y + (shape.kind === "seq" ? EXTRA - 2 : 0) + CELL / 2 - 11, class: "data-look" }, "LOOK HERE"));
      if (shape.changed) row.append(el("text", { x: LABEL, y: y + (shape.kind === "seq" ? EXTRA - 2 : 0) + CELL / 2 + 19, class: "data-changed" }, "CHANGED"));
      const size = drawValue(row, shape, LABEL + 14, y);
      dataGroup.append(row);
      widest = Math.max(widest, LABEL + 14 + size.width);
      y += Math.max(size.height, CELL + 14) + ROW;
    }
    if (linked.length) y = dataGraph(scan, before, linked, y);
    if (!y) note("This step has no variables yet.");
    else if (dataText) {
      // The same values as text, from the same step of the recording (its own text form, cut at 100 characters), in a column to the right of the drawing.
      const box = dataGroup.getBBox(), col = el("g", { class: "data-text" }), x = box.x + box.width + 60;
      col.append(el("text", { x, y: 10, class: "data-title" }, "AS TEXT"));
      Object.keys(entry.shapes).forEach((name, i) => {
        const text = String(entry.locals?.[name] ?? "");
        col.append(el("text", { x, y: 36 + i * 22, class: "data-textline", "data-name": name }, `${name} = ${text.length > 100 ? `${text.slice(0, 100)}…` : text}`));
      });
      dataGroup.append(col);
    }
    // The view is framed when the layer opens, again whenever the drawing grows past what was framed (a structure gets bigger as the run goes on), and whenever the trace table of a replay
    // would cover it (Fit leaves room for it).
    setTimeout(() => {
      const trace = $("trace-table"), g = dataGroup.getBoundingClientRect(), box = dataGroup.getBBox();
      const covered = trace && !trace.hidden && g.height > 0 && g.bottom > trace.getBoundingClientRect().top;
      const grew = box.width > dataFramed.w + 1 || box.height > dataFramed.h + 1;
      if (!dataFitted || covered || grew) { dataFitted = true; dataFramed = { w: box.width, h: box.height }; $("zoom-fit").click(); }
    }, 80);
  }

  document.addEventListener("playback-step", dataDraw);
  // The Tutor's prediction can point at Data: show that step of the open recording and mark the variable in words. False when there is nothing to show (no recording, Data not open yet).
  window.dataUi = {
    point(p) {
      if (dataTab.disabled || !pbRecording) return false;
      dataPointed = p.variable ?? null;
      showLayer("data");
      if (p.step !== undefined) pbGo(Math.min(p.step, pbRecording.visits.length - 1)); else dataDraw();
      return true;
    },
    clearPoint() { if (dataPointed === null) return; dataPointed = null; dataDraw(); },
  };
  // The tab can be chosen once a function's Flow is open; a Project drawn again drops it, like the Flow tab.
  document.addEventListener("algorithm-opened", () => { dataTab.disabled = false; dataFitted = false; });
  const dataDrawProject = draw;
  draw = async (nodes) => { dataTab.disabled = true; dataGroup.replaceChildren(); await dataDrawProject(nodes); };


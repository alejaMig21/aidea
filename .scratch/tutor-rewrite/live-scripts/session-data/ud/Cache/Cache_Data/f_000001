    #tutor-log .tutor-card label { display: flex; gap: 8px; align-items: baseline; color: var(--text); font-size: 13.5px; overflow-wrap: anywhere; }
    #tutor-log .tutor-card input[type=radio] { accent-color: var(--accent); flex: none; }

svg.addEventListener("pointerdown", (e) => { componentsDown = [e.clientX, e.clientY]; });
svg.addEventListener("pointerup", (e) => {
  const moved = componentsDown && Math.hypot(e.clientX - componentsDown[0], e.clientY - componentsDown[1]) >= 4;
  componentsDown = null;

<script>
// Chat bar: renders the events the core streams from POST /chat. No domain logic lives here.
// When the builder needs permission, a card with Approve and Reject appears; the answer goes back through POST /permission.
{
  const log = document.createElement("div");
  log.id = "chat-log";
  log.setAttribute("role", "log");
  const form = document.createElement("form");
  const label = Object.assign(document.createElement("label"), { htmlFor: "chat-input", textContent: "Ask the builder" });
  const input = document.createElement("textarea"); // several lines: a pasted list keeps its line breaks
  input.id = "chat-input";
  input.rows = 1;
  input.placeholder = "Describe what to build or change";
  input.required = true;
  // The box is one line until the text needs more, then grows up to its CSS maximum and scrolls.
  const fit = () => { input.style.height = "auto"; input.style.height = `${input.scrollHeight}px`; };
  input.addEventListener("input", fit);
  // Enter sends; Shift+Enter makes a new line; Enter that confirms an input-method composition does neither.
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing && e.keyCode !== 229) { e.preventDefault(); form.requestSubmit(); } // 229: some browsers report a composition Enter this way
  });
  // The text wraps differently when the column is resized, so the height follows the width.
  let fitWidth = 0;
  // fit() changes the height of the very box that is observed, so it runs a frame later (a Panel moved by the Layout resizes it often).
  new ResizeObserver(() => requestAnimationFrame(() => { if (input.clientWidth !== fitWidth) { fitWidth = input.clientWidth; fit(); } })).observe(input);
  const send = document.createElement("button");
  send.textContent = "Send";
  form.append(label, input, send);
  const foot = Object.assign(document.createElement("div"), { id: "chat-foot" });
  foot.append(form);
  $("chat").append(log, foot);

  const sessions = new Map(); // project id -> Claude Code session id, so follow-ups continue the conversation
  const cards = new Map(); // permission request id -> its card, so a card can be withdrawn

  const add = (cls, text, parent) => {
    const div = document.createElement("div");
    div.className = cls + (parent ? " nested" : "");
    div.textContent = text;
    log.append(div);
    log.scrollTop = log.scrollHeight;
    return div;
  };

  const hint = (input) => {
    const v = input && (input.description || input.command || input.file_path || input.pattern || input.path || input.query);
    return typeof v === "string" ? v.slice(0, 80) : "";
  };

  // The person approves what they see, so the card shows the whole request. Characters that change the order the text
  // is read in, or that cannot be seen, are written out as <U+XXXX> instead of being drawn.
  const visible = (text) =>
    String(text ?? "").replace(/[\u0000-\u0008\u000B-\u001F\u007F؜‎‏‪-‮⁦-⁩]/g, (c) => `<U+${c.charCodeAt(0).toString(16).toUpperCase().padStart(4, "0")}>`);
  const MAX_SHOWN = 20000; // beyond this the card says how much is not shown

  // One labelled block of the request, scrollable.
  function block(label, text) {
    const wrap = document.createElement("div");
    const name = document.createElement("div");
    name.className = "meta";
    name.textContent = label;
    const pre = document.createElement("pre");
    const whole = visible(text);
    pre.textContent = whole.length > MAX_SHOWN ? whole.slice(0, MAX_SHOWN) : whole;
    wrap.append(name, pre);
    if (whole.length > MAX_SHOWN) {
      const more = document.createElement("div");
      more.className = "error";
      more.textContent = `${whole.length - MAX_SHOWN} more characters are not shown here. Reject unless you trust the rest.`;
      wrap.append(more);
    }
    return wrap;
  }

  const requestBlocks = (tool, input) => {
    if (tool === "Bash") {
      return [block("Command", input.command), ...(input.description ? [block("Claude's description (not checked)", input.description)] : [])];
    }
    if (tool === "Write") return [block("File", input.file_path), block("Content", input.content)];
    if (tool === "Edit") return [block("File", input.file_path), block("Replace", input.old_string), block("With", input.new_string)];
    return [block("Request", JSON.stringify(input, null, 2))];
  };

  function permissionCard(event) {
    const box = document.createElement("div");
    box.className = "permission";
    const title = document.createElement("strong");
    title.textContent = `Claude wants to use ${visible(event.tool)}`;
    const row = document.createElement("div");
    row.className = "row";
    const status = document.createElement("span");
    const reason = document.createElement("input");
    reason.placeholder = "Reason for rejecting (optional)";
    reason.setAttribute("aria-label", "Reason for rejecting");
    const approve = document.createElement("button");
    approve.textContent = "Approve";
    const reject = document.createElement("button");
    reject.textContent = "Reject";
    reject.className = "reject";
    const answer = async (decision) => {
      approve.disabled = reject.disabled = true;
      try {
        const res = await fetch("/permission", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ id: event.id, secret: event.secret, decision, message: decision === "deny" ? reason.value.trim() || undefined : undefined }),
        });
        box.classList.add("answered");
        status.textContent = res.ok ? (decision === "allow" ? "Approved" : "Rejected") : (await res.json().catch(() => ({}))).error ?? "Could not send the answer";
      } catch (err) {
        approve.disabled = reject.disabled = false; // the answer did not arrive: the person can try again
        status.textContent = `Could not reach the core: ${err.message}`;
      }
    };
    approve.onclick = () => answer("allow");
    reject.onclick = () => answer("deny");
    row.append(approve, reject, reason, status);
    const note = event.note ? Object.assign(document.createElement("p"), { className: "said", textContent: event.note }) : null; // a question from a plugin's guard rule
    box.append(title, ...(note ? [note] : []), ...requestBlocks(event.tool, event.input ?? {}), row);
    log.append(box);
    log.scrollTop = log.scrollHeight;
    cards.set(event.id, { box, buttons: [approve, reject], reason, status });
  }

  // The builder stopped waiting: the card can no longer be answered.
  function expireCard(id) {
    const card = cards.get(id);
    if (!card || card.box.classList.contains("answered")) return;
    card.box.classList.add("answered");
    card.buttons.forEach((b) => { b.disabled = true; });
    card.reason.disabled = true;
    card.status.textContent = "Expired: Claude stopped waiting for an answer";
  }

  function render(event, project) {
    if (event.type === "session") sessions.set(project, event.sessionId);
    else if (event.type === "permission") permissionCard(event);
    else if (event.type === "plugin_proposed") pmProposed(event); // the Builder wrote a plugin: the manager opens on it
    else if (event.type === "permission_expired") expireCard(event.id);
    else if (event.type === "proposal") {
      // The Canvas shows it highlighted on its layer; the chat says it happened and offers to take the person there.
      const line = add("proposal-line", `${event.source?.role === "tutor" ? "From the Tutor. " : ""}Proposal: ${event.kind} "${event.nodeId}" on the ${event.layer} layer. `);
      const review = document.createElement("button");
      review.textContent = "Review";
      review.onclick = () => document.dispatchEvent(new CustomEvent("proposal-open", { detail: { id: event.id } }));
      line.append(review);
      document.dispatchEvent(new CustomEvent("proposal-created", { detail: event }));
    }
    else if (event.type === "run_recipe_proposal") document.dispatchEvent(new CustomEvent("run-recipe-proposed", { detail: event })); // the Run plugin draws the card
    else if (event.type === "proposal_refused") {
      const [text, open] = proposalRefusedParts(event, "Claude");
      add("proposal-line", text).append(...(open ? [open] : []));
    }
    else if (event.type === "authored_changed") {
      // The builder changed the authored files without a Proposal: say which, and offer the way back.
      const names = event.files.map((f) => f.file.replace(/^\.aidea\//, "")).join(", ");
      const line = add("proposal-line", `Claude changed ${event.files.length === 1 ? "an authored file" : "authored files"} without a proposal: ${names}. `);
      const restore = document.createElement("button");
      restore.textContent = "Restore";
      restore.onclick = async () => {
        restore.disabled = true;
        try {
          const res = await fetch("/authored/restore", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ id: event.id }) });
          const out = await res.json();
          restore.replaceWith(Object.assign(document.createElement("span"), {
            textContent: !res.ok ? out.error : out.skipped.length ? `Restored, except ${out.skipped.join(", ")}: you changed it since.` : "Restored.",
          }));
        } catch (err) {
          restore.disabled = false;
          restore.after(` Could not reach the core: ${err.message}`);
        }
      };
      line.append(restore);
    }
    else if (event.type === "text") add("text", event.text, event.parent);
    else if (event.type === "tool") add("tool", `> ${event.name} ${hint(event.input)}`.trim(), event.parent);
    else if (event.type === "error") add("error", event.message);
    else if (event.type === "result") {
      const bits = [];
      if (event.costUsd != null) bits.push(`$${event.costUsd.toFixed(4)}`);
      if (event.durationMs != null) bits.push(`${(event.durationMs / 1000).toFixed(1)}s`);
      if (bits.length) add("meta", bits.join(" · "));
    }
  }

  // One turn with the builder: `shown` is what the chat says the person wrote, `extra` the fields of the request that carry it (a message, or a fix of selected text).
  async function talk(shown, extra) {
    if (send.disabled) return false; // the builder is still answering
    if (!current) { add("error", "Open a Project first."); return false; }
    const project = current;
    send.disabled = true;
    add("you", shown);
    try {
      const res = await fetch("/chat", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ project, ...extra, sessionId: sessions.get(project) }),
      });
      if (!res.ok) { add("error", (await res.json()).error); return; }
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split("\n");
        buffer = lines.pop();
        for (const line of lines) if (line) render(JSON.parse(line), project);
      }
    } catch (err) {
      add("error", `Could not reach the core: ${err.message}`);
    } finally {
      // A card still waiting when the conversation ends can no longer be answered.
      log.querySelectorAll(".permission:not(.answered) button").forEach((b) => { b.disabled = true; });
      send.disabled = false;
      input.focus();
    }
    return true;
  }
  form.onsubmit = (e) => {
    e.preventDefault();
    if (send.disabled) return; // the builder is still answering: the draft stays in the box
    const message = input.value.trim();
    if (!message) { input.value = ""; fit(); return; }
    if (!current) { add("error", "Open a Project first."); return; }
    input.value = "";
    fit();
    talk(message, { message });
  };
  // For the selection control: "Fix" hands selected text to the builder; the core frames it as data.
  window.chatUi = {
    fix: (text, source) => talk(`Fix this (from the ${source ?? "screen"}): ${text.length > 160 ? text.slice(0, 160) + "…" : text}`, { fix: { text, source } }),
    isBusy: () => send.disabled,
  };
}

</script>
<script>
// Model and Permission mode selectors. Everything shown comes from GET /agent-options (what the active agent adapter
// offers) and every change goes back through POST /agent-options, which remembers it for the Project.
// Names are prefixed "agentOpt" because every feature file shares one global scope.
{
  const make = (label, id) => {
    const s = document.createElement("select");
    s.className = "agent-opt";
    s.id = id;
    s.setAttribute("aria-label", label);
    return s;
  };
  const chatModel = make("Model for the builder", "chat-model");
  const chatMode = make("Permission mode", "chat-mode");
  const tutorModel = make("Tutor model", "tutor-model");

  // The chat input card: the selectors sit bottom-left, Send bottom-right.
  const row = Object.assign(document.createElement("div"), { className: "chat-controls" });
  const form = $("chat-input").form;
  row.append(chatModel, chatMode, form.querySelector("button"));
  form.append(row);

  const modeStyle = document.createElement("style");
  modeStyle.textContent = `
    #tutor-settings { display: flex; align-items: center; gap: 6px 12px; flex-wrap: wrap; font-size: 12px; color: var(--muted); }
    #tutor-settings label { display: flex; align-items: center; gap: 6px; }
    #tutor-settings input { accent-color: var(--accent); }
    #pane-tutor.tutor-live #tutor-settings { display: none; }
  `;
  document.head.append(modeStyle);

  // The Tutor's own settings, in the Tutor panel: its model and the review question at the start of a class
  // (on unless the person turns it off; the choice is remembered for the Project).
  const reviewBox = Object.assign(document.createElement("input"), { type: "checkbox", id: "review-question", checked: true, disabled: true });
  const settings = Object.assign(document.createElement("div"), { id: "tutor-settings" });
  const modelLabel = document.createElement("label");
  modelLabel.append("Tutor model", tutorModel);
  const reviewLabel = document.createElement("label");
  reviewLabel.append(reviewBox, "Start with a review question");
  settings.append(modelLabel, reviewLabel);
  $("tutor-head").after(settings);

  const fill = (select, list, chosen) => {
    select.replaceChildren(...list.map((o) => {
      const opt = Object.assign(document.createElement("option"), { value: o.id, textContent: o.label });
      if (o.available === false) { opt.disabled = true; opt.title = o.reason ?? "Not available"; opt.textContent += " (unavailable)"; }
      else if (o.meaning) opt.title = o.meaning;
      return opt;
    }));
    select.value = chosen;
  };

  async function load(project) {
    for (const s of [chatModel, chatMode, tutorModel]) s.disabled = true;
    reviewBox.disabled = true;
    try {
      const res = await fetch("/agent-options?project=" + encodeURIComponent(project));
      if (!res.ok || project !== current) return;
      const { modes, models, choice, reviewQuestion } = await res.json();
      fill(chatMode, modes, choice.mode);
      fill(chatModel, models, choice.model);
      fill(tutorModel, models, choice.tutorModel);
      chatMode.title = modes.find((m) => m.id === choice.mode)?.meaning ?? "";
      for (const s of [chatModel, chatMode, tutorModel]) s.disabled = false;
      reviewBox.checked = reviewQuestion !== false;
      reviewBox.disabled = false;
    } catch { /* the selectors stay disabled until a Project opens, and no choice is shown as if it were stored */ }
  }

  const save = (field, select) => async () => {
    if (!current) return;
    try {
      const res = await fetch("/agent-options", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ project: current, [field]: select.value }),
      });
      if (!res.ok) load(current); // refused: show what is really stored
      else if (field === "mode") chatMode.title = chatMode.selectedOptions[0]?.title ?? "";
    } catch { load(current); } // the core could not be reached: show what was stored
  };
  reviewBox.onchange = async () => {
    if (!current) return;
    try {
      const res = await fetch("/agent-options", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ project: current, reviewQuestion: reviewBox.checked }) });
      if (!res.ok) load(current); // refused: show what is really stored
    } catch { load(current); }
  };
  chatMode.onchange = save("mode", chatMode);
  chatModel.onchange = save("model", chatModel);
  tutorModel.onchange = save("tutorModel", tutorModel);

  for (const s of [chatModel, chatMode, tutorModel]) s.disabled = true; // until a Project is open
  document.addEventListener("project-opened", (e) => load(e.detail.id));
}

</script>
<script>
// Focus zoom: double-click a Node to open the layer below, framed on what realises it; "Zoom out" goes back.
// The core computes the framing and says what to dim; this only applies them.
const focusStyle = document.createElement("style");
focusStyle.textContent = `
  [data-ref] { transition: opacity .2s; }
  .dim { opacity: .2; }
  .anode.has-broken rect, .bnote.has-broken rect { stroke: var(--danger); stroke-width: 1.5; }
`;
document.head.append(focusStyle);

const zoomOut = document.createElement("button");
zoomOut.textContent = "Zoom out";
zoomOut.hidden = true;
layerBar.append(zoomOut);

const post = (path, body) =>
  fetch(path, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });

// Fits a frame (in layer coordinates) into the visible Canvas.
function fit(frame, maxZoom = 4) {
  const r = svg.getBoundingClientRect();
  view.k = Math.min(maxZoom, Math.max(0.2, Math.min(r.width / frame.width, r.height / frame.height)));
  view.x = (r.width - frame.width * view.k) / 2 - frame.x * view.k;
  view.y = (r.height - frame.height * view.k) / 2 - frame.y * view.k;
  apply();
}
const dim = (ids) => document.querySelectorAll("[data-ref]").forEach((e) => e.classList.toggle("dim", ids.includes(e.dataset.ref)));

// Any other way of changing layer clears the dimming.
const showLayerPlain = showLayer;
showLayer = (which) => { showLayerPlain(which); dim([]); };

svg.addEventListener("dblclick", async (e) => {
  const node = e.target.closest("[data-node]");
  if (!node || authoredShown === "flow") return; // a step of a graph opens its lines (50-algorithm.js); only the authored layers have a focus
  const project = current;
  const res = await post("/focus", { project, layer: authoredShown, node: node.dataset.node });
  const body = await res.json();
  if (project !== current) return; // another Project was opened meanwhile: this answer is stale
  $("error").textContent = res.ok ? "" : body.error;
  if (!res.ok) return;
  showLayer(body.layer);
  fit(body.frame);
  dim(body.dimmed);
  zoomOut.hidden = false;
  if (body.broken.length) $("error").textContent = `Broken links: ${body.broken.join(", ")}`;
});

zoomOut.onclick = async () => {
  const project = current;
  const res = await post("/focus/out", { project });
  const body = await res.json();
  if (project !== current) return;
  if (!res.ok) { zoomOut.hidden = true; $("error").textContent = body.error; return; }
  $("error").textContent = "";
  showLayer(body.layer);
  fit(body.frame);
  zoomOut.hidden = body.remaining === 0;
};

// The Nodes with a Broken link carry a red outline. Every redraw of a layer calls markBroken again.
let brokenFrom = new Set();
function markBroken() {
  document.querySelectorAll(".anode, .bnote").forEach((n) => n.classList.toggle("has-broken", brokenFrom.has(n.dataset.node)));
}

// After each Project is drawn, find the Nodes that have a Broken link.
const drawWithoutBroken = draw;
draw = async (nodes) => {
  await drawWithoutBroken(nodes);
  zoomOut.hidden = true;
  const project = current;
  const res = await fetch(`/traces?project=${encodeURIComponent(project)}`);
  if (!res.ok || project !== current) return;
  const { links } = await res.json();
  brokenFrom = new Set(links.filter((l) => l.broken).map((l) => l.from));
  markBroken();
};


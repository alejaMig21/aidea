<script>
// Pattern groups on the Architecture layer: a labelled boundary around the member Nodes, the role written on each member, and
// each violation the core found (GET /patterns) drawn as a dashed arrow between the two Nodes: red when certain, grey with "?" when only possible.
// The core decides what is a violation; this file only draws. Arrows are static: nothing here moves.
let patternViolations = [];

{
  const style = document.createElement("style");
  style.textContent = `
    .pattern-boundary { fill: none; stroke: var(--authored); stroke-width: 1.2; stroke-dasharray: 2 5; stroke-linecap: round; pointer-events: none; }
    .pattern-title { fill: var(--authored); font: 600 11.5px var(--mono); pointer-events: none; }
    .pattern-role { fill: var(--authored); font: 600 10.5px var(--mono); pointer-events: none; }
    .pattern-violation line { stroke: var(--danger); stroke-width: 2.2; stroke-dasharray: 7 5; }
    .pattern-violation path { fill: var(--danger); }
    .pattern-violation.possible line { stroke: var(--unresolved); }
    .pattern-violation.possible path { fill: var(--unresolved); }
    .pattern-violation .hit { stroke: transparent; stroke-width: 14; stroke-dasharray: none; pointer-events: stroke; }
    .pattern-violation text { fill: var(--danger); font: 700 14px var(--mono); paint-order: stroke; stroke: var(--canvas); stroke-width: 4px; }
    .pattern-violation.possible text { fill: var(--muted); }
  `;
  document.head.append(style);
}

{
  const legend = notationLegends.architecture;
  notationRegisterLegend("architecture", {
    ...legend,
    shapes: [
      ...legend.shapes,
      [notationSwatch(`<rect x="3" y="3" width="38" height="18" rx="4" style="fill:none;stroke:var(--authored);stroke-dasharray:2 4"/>`), "Pattern group: a dotted boundary around Nodes that realise one pattern (for example hexagonal); each member is tagged with its role", ".pattern-boundary"],
    ],
    arrows: [
      ...legend.arrows,
      [notationSwatch(`<path d="M2 12H34" style="stroke:var(--danger);stroke-width:2;stroke-dasharray:6 4"/><path d="M42 12L33 7.5V16.5Z" style="fill:var(--danger)"/>`), "Red dashed arrow: the code breaks the pattern's rule (for example the domain depends on infrastructure). Hover for the rule and the evidence", ".pattern-violation:not(.possible)"],
      [notationSwatch(`<path d="M2 12H34" style="stroke:var(--unresolved);stroke-width:2;stroke-dasharray:6 4"/><path d="M42 12L33 7.5V16.5Z" style="fill:var(--unresolved)"/>`), "Grey dashed arrow with ?: the analysis could only guess (matched by name), so the violation is possible, not certain", ".pattern-violation.possible"],
    ],
    notShown: [...legend.notShown, "Rules of a pattern other than the ones in its kind (hexagonal: domain never depends on adapters or infrastructure; layered: lower layers never depend on upper ones)"],
  });
}

// Where the line from the centre of `a` towards the centre of `b` leaves `a`.
function patternEdge(a, b) {
  const [ax, ay, bx, by] = [a.x + a.width / 2, a.y + a.height / 2, b.x + b.width / 2, b.y + b.height / 2];
  const [dx, dy] = [bx - ax, by - ay];
  const t = Math.min(dx ? a.width / 2 / Math.abs(dx) : Infinity, dy ? a.height / 2 / Math.abs(dy) : Infinity);
  return { x: ax + dx * t, y: ay + dy * t };
}

function patternsDraw() {
  const g = authoredGroup.querySelector('[data-layer="architecture"]');
  const drawing = architecturePreview ?? architectureDrawing;
  g?.querySelectorAll(".pattern-under, .pattern-over").forEach((x) => x.remove());
  const groups = authoredData?.layers.architecture.patterns ?? [];
  if (!g || !drawing || !groups.length) return;
  const rects = new Map(drawing.rects.map((r) => [r.id, r]));
  const under = el("g", { class: "pattern-under" }), over = el("g", { class: "pattern-over" });
  for (const group of groups) {
    const members = group.roles.map((r) => ({ ...r, rect: rects.get(r.node) })).filter((m) => m.rect);
    if (!members.length) continue;
    const x1 = Math.min(...members.map((m) => m.rect.x)) - 20, y1 = Math.min(...members.map((m) => m.rect.y)) - 46;
    const x2 = Math.max(...members.map((m) => m.rect.x + m.rect.width)) + 20, y2 = Math.max(...members.map((m) => m.rect.y + m.rect.height)) + 20;
    // ponytail: one box around all members; it can also cover a Node that is not in the group. Draw per-member hulls if that confuses.
    under.append(
      el("rect", { class: "pattern-boundary", "data-pattern": group.id, x: x1, y: y1, width: x2 - x1, height: y2 - y1, rx: 14 }),
      el("text", { class: "pattern-title", x: x1 + 12, y: y1 + 17 }, `${group.name} [${group.kind}]`),
    );
    for (const m of members) under.append(el("text", { class: "pattern-role", x: m.rect.x + m.rect.width - 8, y: m.rect.y - 7, "text-anchor": "end" }, `«${m.role}»`));
  }
  for (const v of patternViolations) {
    const [a, b] = [rects.get(v.from.node), rects.get(v.to.node)];
    if (!a || !b) continue;
    const p = patternEdge(a, b), q = patternEdge(b, a);
    const [ux, uy] = [q.x - p.x, q.y - p.y], len = Math.hypot(ux, uy) || 1, [nx, ny] = [ux / len, uy / len];
    const possible = v.certainty === "possible";
    const e = v.evidence[0];
    const tip = `${possible ? "Possible violation" : "Violation"}: ${v.rule}\n${v.from.node} (${v.from.role}) -> ${v.to.node} (${v.to.role})\n${e.kind} ${e.from} -> ${e.to} at line ${e.line}, ${e.resolution}${v.evidence.length > 1 ? ` (+${v.evidence.length - 1} more)` : ""}`;
    const arrow = el("g", { class: `pattern-violation${possible ? " possible" : ""}`, "data-violation": `${v.from.node}>${v.to.node}`, tabindex: 0 });
    arrow.append(
      el("title", {}, tip),
      el("line", { x1: p.x, y1: p.y, x2: q.x - nx * 8, y2: q.y - ny * 8 }),
      el("line", { class: "hit", x1: p.x, y1: p.y, x2: q.x, y2: q.y }),
      el("path", { d: `M${q.x} ${q.y}L${q.x - nx * 11 - ny * 5} ${q.y - ny * 11 + nx * 5}L${q.x - nx * 11 + ny * 5} ${q.y - ny * 11 - nx * 5}Z` }),
    );
    if (possible) arrow.append(el("text", { x: (p.x + q.x) / 2 + 6, y: (p.y + q.y) / 2 - 6 }, "?"));
    over.append(arrow);
  }
  g.prepend(under);
  g.append(over);
}

const architectureRenderWithoutPatterns = architectureRender;
architectureRender = () => { architectureRenderWithoutPatterns(); patternsDraw(); };

async function patternsRefresh() {
  const project = current;
  const body = project ? await fetch(`/patterns?project=${encodeURIComponent(project)}`).then((r) => (r.ok ? r.json() : null)).catch(() => null) : null;
  if (project !== current) return;
  patternViolations = body?.violations ?? [];
  patternsDraw();
}
const drawWithoutPatterns = draw;
draw = async (nodes) => { await drawWithoutPatterns(nodes); await patternsRefresh(); };

</script>
<script>
// Requirements layer: functional stories with a checklist of acceptance criteria on the left, non-functional cards
// (quality tag and measure) on the right, and trace links drawn from each card, down its checklist, to what it points at:
// code for a functional requirement, Architecture for a non-functional one. The core decides where each card sits
// (layoutRequirements); card heights depend on the number of criteria, so the drawing only follows the rectangles it is given.
// This file loads after 45-notation.js because it registers its legend there.
const REQ_CHIP_X = 24, REQ_CHIP_W = 170, REQ_MAX_CHIPS = 3; // ponytail: only the first 3 trace targets of a requirement get a chip (the legend says so)
let requirementTraces = {}; // node id -> [{ to, broken }], from GET /traces

{
  const style = document.createElement("style");
  style.textContent = `
    .anode .req-box { fill: var(--bar); stroke: var(--control); }
    .anode .req-tag { fill: color-mix(in srgb, var(--authored) 14%, var(--bar)); stroke: color-mix(in srgb, var(--authored) 55%, transparent); }
    .req-kicker { fill: var(--muted); font: 600 10px var(--mono); letter-spacing: .1em; }
    .req-title { font-size: 14px; font-weight: 600; }
    .req-line { fill: var(--label); font-size: 12.5px; font-weight: 400; }
    .req-line .req-b { fill: var(--authored); font-weight: 600; }
    .req-crit { fill: var(--label); font: 400 11px var(--mono); }
    .req-tagtext { fill: var(--authored); font: 600 10.5px var(--mono); letter-spacing: .06em; }
    .req-measure { fill: var(--muted); font: 400 11px var(--mono); }
    .req-group { fill: var(--muted); font: 600 11px var(--mono); letter-spacing: .12em; }
    .req-edge { pointer-events: none; }
    .req-chip rect { fill: var(--raised); stroke: var(--derived); stroke-width: 1.2; }
    .req-chip.arch rect { stroke: var(--authored); }
    .req-chip.broken rect { stroke: var(--unresolved); stroke-dasharray: 5 4; }
    .req-chip text { fill: var(--label); font: 400 11.5px var(--mono); }
  `;
  document.head.append(style);
}

// "As a <as>, I want <want>" with the person's words in the authored colour, cut as a whole at `max` characters.
function reqStory(parts, max, x, y) {
  const t = el("text", { x, y, class: "req-line" });
  let left = max;
  for (const [text, bold] of parts) {
    if (left <= 0) break;
    t.append(el("tspan", bold ? { class: "req-b" } : {}, notationClip(text, left)));
    left -= text.length;
  }
  return t;
}

function reqCard(n, r) {
  const nfr = n.kind === "non-functional";
  const { x, y } = r;
  const g = el("g", { class: `anode req ${nfr ? "req-nfr" : "req-fn"}`, tabindex: 0, "data-node": n.id, "data-ref": n.id });
  g.append(
    el("title", {}, nfr ? `${n.title}: ${n.statement} (${n.quality}; measure: ${n.measure})` : `${n.title}: As ${n.as}, I want ${n.want}, so that ${n.so}`),
    el("rect", { x, y, width: r.width, height: r.height, rx: 12 }),
    el("text", { x: x + 36, y: y + 22, class: "req-kicker" }, nfr ? "NON-FUNCTIONAL" : "USER STORY"),
    el("circle", { cx: x + 20, cy: y + 37, r: 4, class: "dot-authored" }),
    el("text", { x: x + 36, y: y + 42, class: "req-title" }, notationClip(n.title, 30)),
  );
  if (nfr) {
    g.append(
      el("text", { x: x + 36, y: y + 62, class: "req-line" }, notationClip(n.statement, 40)),
      el("rect", { x: x + 36, y: y + 70, width: n.quality.length * 7 + 18, height: 18, rx: 9, class: "req-tag" }),
      el("text", { x: x + 45, y: y + 83, class: "req-tagtext" }, n.quality.toUpperCase()),
      el("text", { x: x + 36, y: y + 104, class: "req-measure" }, notationClip(`Measure: ${n.measure}`, 38)),
    );
    return g;
  }
  g.append(
    reqStory([["As a ", 0], [n.as, 1], [", I want ", 0], [n.want, 1]], 40, x + 36, y + 62),
    reqStory([["so that ", 0], [n.so, 1]], 40, x + 36, y + 80),
  );
  (n.criteria ?? []).forEach((c, i) => {
    const top = y + 92 + 22 * i;
    g.append(
      el("rect", { x: x + 13, y: top + 1, width: 14, height: 14, rx: 4, class: "req-box" }),
      el("text", { x: x + 36, y: top + 13, class: "req-crit" }, notationClip(c, 38)),
    );
  });
  return g;
}

// The rail runs from the card's dot down past its criteria (the checkboxes), then out to each chip. Packets follow that path.
function reqTrace(n, r) {
  const nfr = n.kind === "non-functional";
  const railX = r.x + 20, railY = r.y + r.height - 8;
  const chipX = r.x + r.width + REQ_CHIP_X;
  const links = (requirementTraces[n.id] ?? (n.traces ?? []).map((to) => ({ to, broken: false }))).slice(0, REQ_MAX_CHIPS);
  return links.flatMap(({ to, broken }, i) => {
    const cy = railY - 30 * i;
    const edge = el("path", {
      class: "edge req-edge", "data-flow": "", "data-packets": 1, "data-tone": broken ? "unresolved" : nfr ? "authored" : "derived", "data-ends": `${n.id} ${to}`,
      d: `M${railX} ${r.y + 37}V${railY}H${chipX - 12}V${cy}H${chipX}`,
    });
    const chip = el("g", { class: `req-chip ${nfr ? "arch" : "code"}${broken ? " broken" : ""}`, "data-ref": to });
    chip.append(
      el("title", {}, `${nfr ? "Architecture" : "Code"}: ${to}${broken ? " (not found)" : ""}`),
      el("rect", { x: chipX, y: cy - 12, width: REQ_CHIP_W, height: 24, rx: 8 }),
      el("text", { x: chipX + 10, y: cy + 4 }, notationClip(to, 20)),
    );
    return [edge, chip];
  });
}

// Called by drawAuthored for the requirements layer: headings, cards, then the trace links over them.
function drawRequirements(g, nodes, rects, select) {
  const at = (n) => rects.find((r) => r.id === n.id);
  for (const [nonFunctional, text] of [[false, "FUNCTIONAL · what the system does"], [true, "NON-FUNCTIONAL · how well, within which limits"]]) {
    const first = nodes.find((n) => (n.kind === "non-functional") === nonFunctional);
    if (first) g.append(el("text", { x: at(first).x, y: -14, class: "req-group" }, text));
  }
  const cards = nodes.map((n) => {
    const card = reqCard(n, at(n));
    card.addEventListener("click", () => select(n, card));
    card.addEventListener("keydown", (e) => { if (e.key === "Enter") select(n, card); });
    return card;
  });
  g.append(...cards, ...nodes.flatMap((n) => reqTrace(n, at(n))));
}

// The Tutor panel also lists what a card only shows in part.
const showRationaleWithoutRequirements = showRationale;
showRationale = (n) => {
  showRationaleWithoutRequirements(n);
  if (authoredShown !== "requirements") return;
  const heading = (text) => Object.assign(document.createElement("h2"), { textContent: text });
  const panel = $("panel");
  if (n.kind === "non-functional") {
    panel.append(heading(`Quality: ${n.quality}`), Object.assign(document.createElement("p"), { textContent: `${n.statement} Measure: ${n.measure}` }));
  } else if (n.criteria?.length) {
    const ul = document.createElement("ul");
    ul.replaceChildren(...n.criteria.map((c) => Object.assign(document.createElement("li"), { textContent: c })));
    panel.append(heading("Acceptance criteria"), ul);
  }
};

// Which trace links are broken is the core's to say: fetch them after each draw and redraw this layer when they change.
const drawWithoutRequirementTraces = draw;
draw = async (nodes) => {
  await drawWithoutRequirementTraces(nodes);
  const project = current;
  const res = await fetch(`/traces?project=${encodeURIComponent(project)}`);
  if (!res.ok || project !== current || !authoredData) return;
  const next = {};
  for (const l of (await res.json()).links) if (l.layer === "requirements") (next[l.from] ??= []).push({ to: l.to, broken: l.broken });
  if (JSON.stringify(next) === JSON.stringify(requirementTraces)) return;
  requirementTraces = next;
  drawAuthored();
  showLayer(authoredShown);
  markBroken(); // the redraw made new cards
};

notationRegisterLegend("requirements", {
  shapes: [
    [notationSwatch(`<rect x="4" y="3" width="36" height="18" rx="5" style="fill:var(--raised);stroke:var(--control)"/><rect x="9" y="7" width="26" height="3" rx="1" style="fill:var(--authored)"/>`), "Functional: a user story (As a, I want, so that) with its acceptance criteria", ".req-fn"],
    [notationSwatch(`<rect x="4" y="4" width="14" height="14" rx="4" style="fill:var(--bar);stroke:var(--control)"/><rect x="22" y="9" width="18" height="4" rx="2" style="fill:var(--muted)"/>`), "A Given / When / Then criterion in the checklist", ".req-box"],
    [notationSwatch(`<rect x="4" y="3" width="36" height="18" rx="5" style="fill:var(--raised);stroke:var(--control)"/><rect x="9" y="12" width="22" height="6" rx="3" style="fill:var(--authored);opacity:.55"/>`), "Non-functional: a statement, its quality tag and how it is measured", ".req-nfr"],
    [notationSwatch(`<rect x="4" y="5" width="36" height="14" rx="5" style="fill:var(--raised);stroke:var(--derived)"/>`), "Trace chip: the code (teal) or the Architecture element (amber) the requirement points at; grey dashed when it is not found", ".req-chip"],
  ],
  arrows: [[notationSwatch(`<path d="M2 12H36" style="stroke:var(--derived);stroke-width:1.6;stroke-dasharray:7 5"/><path d="M34 7L42 12L34 17" style="fill:none;stroke:var(--derived);stroke-width:1.5"/>`), "Trace link: from the card, past its criteria, to its target; the dot travels that way", ".req-edge"]],
  colours: [
    ["authored", "Amber: written by a person or the agent (the card's dot, the words of the story, the quality tag, a link to Architecture)"],
    ["derived", "Teal: found in the code (a link to code)"],
    ["unresolved", "Grey, dashed: a link whose target is not found, never moving"],
    ["danger", "Red outline on a card: a link from it is broken, or the code differs from what the Contract says"],
  ],
  notShown: ["Priority (no Must or Should labels)", "Story maps", "Whether each criterion passes", "More than three trace targets per requirement"],
});

